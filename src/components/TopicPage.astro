---
import ReaderCard from './ReaderCard.astro';
import { getTopicIds, localeBase } from '../data/site-reader.mjs';
import '../styles/reader.css';
interface Props { topic: any; entries: any[]; research: any[]; projects: any[]; locale?: 'en' | 'zh-Hant' }
const { topic, entries, research, projects, locale = 'en' } = Astro.props;
const isZh = locale === 'zh-Hant';
const base = localeBase(locale);
const articles = entries.filter(entry => !entry.data.archived && getTopicIds(entry.data).includes(topic.id)).sort((a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0));
const programmes = research.filter(entry => getTopicIds(entry.data).includes(topic.id));
const overviews = projects.filter(entry => getTopicIds(entry.data).includes(topic.id)).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year);
---
<header class="page-head reader-page-head"><div class="container"><nav class="reader-breadcrumbs" aria-label={isZh ? '所在位置' : 'Breadcrumb'} data-pagefind-ignore><ol><li><a href={`${base}/`}>{isZh ? '首頁' : 'Home'}</a></li><li><a href={`${base}/topics/`}>{isZh ? '主題' : 'Topics'}</a></li><li aria-current="page">{topic.label[locale]}</li></ol></nav><p class="eyebrow">{isZh ? '主題' : 'Topic'}</p><h1>{topic.label[locale]}</h1><p class="lead">{topic.description[locale]}</p></div></header>
<section class="reader-section"><div class="container"><div class="reader-section-heading"><h2>{isZh ? '由文章開始' : 'Start with an article'}</h2><a href={`${base}/writing/?topic=${topic.id}`}>{isZh ? '篩選此主題文章' : 'Filter writing on this topic'} →</a></div>{articles.length > 0 ? <div class="reader-card-grid">{articles.slice(0, 6).map(entry => <ReaderCard entry={entry} locale={locale} />)}</div> : <p class="reader-empty">{isZh ? '這個主題嘅新文章準備中，可以先睇下面嘅研究方向。' : 'New writing for this topic is in preparation. Explore the research below.'}</p>}</div></section>
{(programmes.length > 0 || overviews.length > 0) && <section class="reader-section reader-topic-research"><div class="container"><h2>{isZh ? '再深入一步' : 'Go a little deeper'}</h2>{programmes.length > 0 && <div class="reader-overview-group"><h3>{isZh ? '研究方向' : 'Research programmes'}</h3><div class="reader-overview-grid">{programmes.map(entry => <article><h4><a href={`${base}/research/${entry.data.slug}/`}>{entry.data.title}</a></h4><p>{entry.data.summary}</p></article>)}</div></div>}{overviews.length > 0 && <div class="reader-overview-group"><h3>{isZh ? '專案概覽' : 'Project overviews'}</h3><div class="reader-overview-grid">{overviews.slice(0, 6).map(entry => <article><p class="small">{entry.data.year}</p><h4><a href={`${base}/projects/${entry.data.slug}/`}>{entry.data.title}</a></h4><p>{entry.data.summary}</p></article>)}</div>{overviews.length > 6 && <details class="reader-more-overviews"><summary>{isZh ? `更多相關專案（${overviews.length - 6}）` : `More related projects (${overviews.length - 6})`}</summary><ul>{overviews.slice(6).map(entry => <li><a href={`${base}/projects/${entry.data.slug}/`}>{entry.data.title}</a><span class="small">{entry.data.year}</span></li>)}</ul></details>}</div>}<p class="reader-topic-secondary"><a href={`${base}/projects/`}>{isZh ? '瀏覽完整技術專案目錄' : 'Browse the complete technical catalogue'} →</a></p></div></section>}
