---
import { articleType, canonicalId, getTopicIds, localeBase, readingMinutes, TOPICS } from '../data/site-reader.mjs';
import { getReaderMedia } from '../data/reader-media.mjs';
import '../styles/editorial-cards.css';
interface Props {
  entry: any;
  locale?: 'en' | 'zh-Hant';
  hidden?: boolean;
  filterCard?: boolean;
  variant?: 'feature' | 'compact';
  headingLevel?: 2 | 3;
  eager?: boolean;
}
const { entry, locale = 'en', hidden = false, filterCard = false, variant, headingLevel = 2, eager = false } = Astro.props;
const isZh = locale === 'zh-Hant';
const base = localeBase(locale);
const topicIds: string[] = getTopicIds(entry.data);
const search = [entry.data.title, entry.data.summary, ...(entry.data.topics || []), ...topicIds].join(' ');
const Heading = headingLevel === 3 ? 'h3' : 'h2';
const cover = variant === 'feature' ? getReaderMedia(canonicalId(entry.data), locale)?.cover : null;
---
<article class:list={['reader-card', variant && 'editorial-card', variant && `editorial-card--${variant}`]} hidden={hidden} data-article-card={filterCard || undefined}
  data-topic-ids={filterCard ? topicIds.join(' ') : undefined}
  data-type={filterCard ? articleType(entry.data.type, 'en') : undefined}
  data-year={filterCard ? entry.data.date?.getFullYear() || '' : undefined}
  data-archived={filterCard ? String(entry.data.archived) : undefined}
  data-search={filterCard ? search : undefined}>
  {variant === 'feature' && <div class:list={['editorial-card-media', !cover && 'editorial-card-media--fallback']} aria-hidden="true">
    {cover ? <img src={cover.src} width={cover.width} height={cover.height} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} /> : <img src="/images/kenneth-woven-knot.svg" width="96" height="96" alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />}
  </div>}
  <div class="reader-card-content">
  <p class="reader-card-meta"><span>{articleType(entry.data.type, locale)}</span>{entry.data.archived && <span class="reader-archive-badge">{isZh ? '典藏' : 'Archived'}</span>}</p>
  <Heading class="editorial-card-title"><a href={`${base}/writing/${entry.data.slug}/`}>{entry.data.title}</a></Heading>
  <p class="reader-card-summary">{entry.data.summary}</p>
  <p class="reader-card-meta">
    {entry.data.date && <time datetime={entry.data.date.toISOString().slice(0, 10)}>{entry.data.date.toLocaleDateString(isZh ? 'zh-Hant-TW' : 'en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}</time>}
    <span>{isZh ? `約 ${readingMinutes(entry, locale)} 分鐘` : `${readingMinutes(entry, locale)} min read`}</span>
  </p>
  <div class="reader-topic-links">{topicIds.slice(0, 2).map(id => <a href={`${base}/topics/${id}/`}>{TOPICS.find(topic => topic.id === id)?.label[locale]}</a>)}</div>
  </div>
</article>
