---
import { getTopicIds, localeBase, TOPICS } from '../data/site-reader.mjs';
import { getReadingPaths } from '../data/reading-paths.mjs';
import TopicIcon from './TopicIcon.astro';
import '../styles/reader.css';
import '../styles/reader-paths.css';
interface Props { entries: any[]; research: any[]; locale?: 'en' | 'zh-Hant' }
const { entries, research, locale = 'en' } = Astro.props;
const isZh = locale === 'zh-Hant';
const base = localeBase(locale);
const paths = getReadingPaths(entries, locale);
---
<header class="page-head reader-page-head"><div class="container"><p class="eyebrow">{isZh ? '主題' : 'Topics'}</p><h1>{isZh ? '由一個問題，讀到另一個世界。' : 'One question opens another world.'}</h1><p class="lead">{isZh ? '八個入口，串連文章、研究方向與專案。先揀一個你想了解嘅問題。' : 'Eight starting points connect writing, research programmes and projects. Start with something you want to understand.'}</p></div></header>
<section class="reader-section"><div class="container"><div class="reader-topics-grid">{TOPICS.map((topic, index) => {
  const count = entries.filter(entry => !entry.data.archived && getTopicIds(entry.data).includes(topic.id)).length;
  return <article class="reader-topic-card"><div class="editorial-topic-identity"><span class="reader-topic-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><TopicIcon topicId={topic.id} /></div><h2><a href={`${base}/topics/${topic.id}/`}>{topic.label[locale]}</a></h2><p>{topic.description[locale]}</p><span class="small">{isZh ? `${count} 篇文章` : `${count} articles`}</span></article>;
})}</div><div class="reader-topic-secondary"><p>{isZh ? '想睇研究全貌？' : 'Looking for the wider research picture?'}</p><a href="#research-programmes">{isZh ? '研究方向' : 'Research programmes'}</a><a href={`${base}/projects/`}>{isZh ? '完整專案目錄' : 'Complete project catalogue'}</a></div></div></section>
<section class="reader-section" aria-labelledby="reading-paths-heading"><div class="container"><div class="reader-section-heading"><div><p class="eyebrow">{isZh ? '跟著問題走' : 'Follow a question'}</p><h2 id="reading-paths-heading">{isZh ? '揀一條閱讀路線。' : 'Choose a reading path.'}</h2></div><a href={`${base}/topics/routes/`}>{isZh ? '全部閱讀路線' : 'All reading paths'} →</a></div><p>{isZh ? '每條路線先讀三篇主線，再按興趣揀讀一篇進階文章。' : 'Read three core articles in order, then choose an optional advanced article.'}</p><div class="reader-path-grid">{paths.map(path => <article class="reader-path-card" data-reading-path={path.id}><p class="eyebrow">{isZh ? '閱讀路線' : 'Reading path'}</p><h3><a href={path.href}>{path.title}</a></h3><p>{path.description}</p><p class="reader-path-meta">{isZh ? `主線 ${path.coreCount} 篇 · 約 ${path.coreMinutes} 分鐘` : `${path.coreCount} core articles · about ${path.coreMinutes} min`}</p><p class="reader-path-first-title">{isZh ? '第一篇：' : 'First: '}{path.first.title}</p><div class="reader-path-actions"><a class="button" href={path.first.href} data-path-first>{isZh ? '由第一篇開始' : 'Start with the first article'} →</a><a href={path.href}>{isZh ? '查看路線' : 'View the path'}</a></div></article>)}</div><p class="reader-topic-secondary"><a href={`${base}/concepts/`}>{isZh ? '遇到新概念？瀏覽概念索引' : 'Met an unfamiliar idea? Browse the concepts index'} →</a></p></div></section>
<section class="reader-section reader-topic-research" id="research-programmes" aria-labelledby="programmes-heading"><div class="container">
  <div class="reader-section-heading"><div><p class="eyebrow">{isZh ? '研究方向' : 'Research programmes'}</p><h2 id="programmes-heading">{isZh ? '跨越專案的研究問題。' : 'Questions that connect projects.'}</h2></div></div>
  <p>{isZh ? '由長期研究問題深入了解模型、方法、證據與尚未解決的限制。' : 'Explore longer-term questions through models, methods, evidence and open limitations.'}</p>
  <div class="reader-overview-grid">{research.map(entry => <article><p class="eyebrow">{entry.data.programme}</p><h3><a href={`${base}/research/${entry.data.slug}/`}>{entry.data.title}</a></h3><p>{entry.data.summary}</p><div class="tag-list">{entry.data.methods.map((method: string) => <span class="tag">{method}</span>)}</div></article>)}</div>
  <p class="reader-topic-secondary"><a href={`${base}/projects/`}>{isZh ? '瀏覽完整技術專案目錄' : 'Browse the complete technical catalogue'} →</a></p>
</div></section>
