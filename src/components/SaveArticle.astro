---
interface Props {articleId:string;title:string;href:string;locale?:'en'|'zh-Hant'}
const {articleId,title,href,locale='en'}=Astro.props;
const zh=locale==='zh-Hant';
---
<div class="save-article" data-save-article data-article-id={articleId} data-title={title} data-href={href} data-locale={locale} data-pagefind-ignore>
  <button type="button" class="button secondary" aria-pressed="false" disabled>{zh?'加入稍後閱讀':'Save for later'}</button>
  <a href={zh?'/zh/reading-list/':'/reading-list/'}>{zh?'我的閱讀清單':'My reading list'}</a>
  <span class="small save-status" data-save-status aria-live="polite"></span>
  <noscript><span class="small">{zh?'收藏功能需要 JavaScript。':'Saving articles requires JavaScript.'}</span></noscript>
</div>
<script>import '../scripts/reading-list-client';</script>
<style>
.save-article{display:flex;gap:.75rem 1rem;align-items:center;flex-wrap:wrap;margin:1.25rem 0}.save-article button[aria-pressed=true]{background:var(--green,#1f6652);color:#fff}.save-status:not(:empty){flex-basis:100%;max-width:45rem}
</style>
