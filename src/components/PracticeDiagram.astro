{lower?<LowerPracticeDiagram diagram={d} locale={locale} solution={solution}/>:<figure class="guided-diagram" data-diagram-kind={d.kind}>
 <svg viewBox={d.kind==='geometry'&&(d.polygons||[]).length===2?'-15 20 410 250':'-15 -15 410 320'} role="img" aria-label={caption} xmlns="http://www.w3.org/2000/svg">
  <title>{caption}</title>
  {polygons.map(points=><polygon points={points.map(p=>p.join(',')).join(' ')} fill="none" stroke="currentColor" stroke-width="2"/>)}
  {circles.map(c=><circle cx={c.c[0]} cy={c.c[1]} r={c.r} fill="none" stroke="currentColor" stroke-width="2"/>)}
  {ellipses.map(c=><ellipse cx={c.c[0]} cy={c.c[1]} rx={c.rx} ry={c.ry} fill="none" stroke="currentColor" stroke-width="2"/>)}
  {lines.map(l=><line x1={l.a[0]} y1={l.a[1]} x2={l.b[0]} y2={l.b[1]} class={l.style}/>)}
  {paths.map(p=><path d={p.d} class={p.style} fill="none"/>)}
  {dots.map(p=><circle cx={p[0]} cy={p[1]} r="2.8" fill="currentColor"/>)}
  {texts.map(v=><text x={v.p[0]+v.dx} y={v.p[1]+v.dy} font-size="18" fill="currentColor">{v.text}</text>)}
 </svg>
 <figcaption>{caption}</figcaption>
</figure>}
