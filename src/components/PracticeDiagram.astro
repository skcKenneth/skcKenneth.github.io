const right=(v:number[],a:number[],b:number[])=>{const u=a.map((x,i)=>x-v[i]),w=b.map((x,i)=>x-v[i]),un=Math.hypot(...u),wn=Math.hypot(...w);if(!un||!wn)return;const p=v.map((x,i)=>x+u[i]/un*11),r=v.map((x,i)=>x+w[i]/wn*11),q=p.map((x,i)=>x+w[i]/wn*11);paths.push({d:`M${p} L${q} L${r}`,style:'right'});};
const tick=(a:number[],b:number[],n=1)=>{const m=a.map((x,i)=>(x+b[i])/2),u=[b[1]-a[1],a[0]-b[0]],len=Math.hypot(...u);if(!len)return;for(let i=0;i<n;i++){const off=(i-(n-1)/2)*5,along=[(b[0]-a[0])/len*off,(b[1]-a[1])/len*off];L(m.map((x,j)=>x+along[j]-u[j]/len*5),m.map((x,j)=>x+along[j]+u[j]/len*5),'mark');}};
const arc=(c:number[],r:number,a:number,b:number)=>{const p=[c[0]+r*Math.cos(a),c[1]+r*Math.sin(a)],q=[c[0]+r*Math.cos(b),c[1]+r*Math.sin(b)];paths.push({d:`M${p} A${r},${r} 0 0,1 ${q}`,style:'construction'});};
const names=d.labels||{};
const caption=d.caption?.[locale]||(zh?'幾何示意圖；除作圖任務外，圖形不按比例。':'Geometry diagram; not drawn to scale except for construction tasks.');
if(d.kind==='bisector'){
 const o=[65,145],a=[320,30],b=[320,260],p=[190,145];
 const foot=(v:number[])=>{const u=v.map((x,i)=>x-o[i]),f=p.reduce((s,x,i)=>s+(x-o[i])*u[i],0)/u.reduce((s,x)=>s+x*x,0);return o.map((x,i)=>x+f*u[i]);};
 const m=foot(a),n=foot(b),angle=(Number(d.rotation)||0)*Math.PI/180;
