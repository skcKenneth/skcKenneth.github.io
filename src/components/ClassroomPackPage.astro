---
import { getClassroomPack, classroomPackHref, classroomEngineHref, classroomSharePath, classroomSettingRows } from '../data/classroom-packs.mjs';
import '../styles/classroom-packs.css';
import MathExpression from './MathExpression.astro';
interface Props { packId:string;locale?:'en'|'zh-Hant';teacher?:boolean }
const {packId,locale='en',teacher=false}=Astro.props;
const pack=getClassroomPack(packId);
if(!pack)throw new Error(`Unknown classroom pack: ${packId}`);
const zh=locale==='zh-Hant',base=zh?'/zh':'';
const t=(en:string,ch:string)=>zh?ch:en;
const rows=classroomSettingRows(packId,{},locale);
---
<div class="classroom-page" data-classroom-pack={teacher?undefined:pack.id} data-classroom-teacher={teacher?pack.id:undefined} data-locale={locale}>
  <header class="page-head"><div class="container classroom-reading-width">
    <nav class="classroom-breadcrumbs" aria-label={t('Breadcrumb','所在位置')} data-pagefind-ignore><ol><li><a href={`${base}/`}>{t('Home','首頁')}</a></li><li><a href={`${base}/teaching/`}>{t('Teaching','教學')}</a></li><li><a href={`${base}/teaching/classroom-packs/`}>{t('One-class activities','一節課活動')}</a></li>{teacher?<><li><a href={classroomPackHref(pack.id,locale)}>{pack.title[locale]}</a></li><li aria-current="page">{t('Teacher reference','教師參考')}</li></>:<li aria-current="page">{pack.title[locale]}</li>}</ol></nav>
    <p class="eyebrow">{teacher?t('Teacher reference · public page','教師參考 · 公開頁面'):t('Student classroom guide','學生課堂指引')}</p>
    <h1 data-pagefind-meta="title">{teacher?`${pack.title[locale]}${zh?'｜教師參考':' — Teacher reference'}`:pack.title[locale]}</h1>
    <p class="lead" data-pagefind-meta="description">{teacher?t('Prepare the lesson, inspect the reasoning and keep the evidence limits visible.','準備課堂、檢視推理，並保留證據的適用範圍。'):pack.question[locale]}</p>
    <p class="classroom-meta">{pack.minutes} {t('minutes','分鐘')} · {pack.audience[locale]}</p>
    <div class="classroom-page-actions" data-pagefind-ignore><a href={classroomPackHref(pack.id,locale,!teacher)} data-classroom-reference>{teacher?t('Open student guide','開啟學生指引'):t('Teacher reference','教師參考')}</a><button class="button secondary" type="button" data-classroom-print>{teacher?t('Print teacher reference','列印教師參考'):t('Print tasks and worksheet','列印任務及工作紙')}</button><button class="button secondary" type="button" data-classroom-projection-toggle aria-pressed="false">{t('Projection mode','投影模式')}</button></div>
  </div></header>
  <div class="classroom-projection-bar" data-classroom-projection-bar hidden data-pagefind-ignore><span>{teacher?t('Teacher reference projected — contains reference reasoning','正在投影教師參考——包含參考推理'):t('Student tasks projected','正在投影學生任務')}</span><button class="button secondary" type="button" data-classroom-projection-exit>{t('Exit projection (Esc)','結束投影（Esc）')}</button></div>
  <div class="container classroom-reading-width classroom-body">
    <section aria-labelledby="classroom-before"><h2 id="classroom-before">{t('Before you begin','開始前')}</h2><p>{pack.prerequisites[locale]}</p><p class="classroom-notice">{pack.scope[locale]}</p>{pack.id==='sampling-bias'&&<p>{t('Synthetic starting counts: the whole school has 200 people, with 100 choosing A; the activity group has 40 people, with 36 choosing A. These fixed counts support a paper comparison and are not a newly drawn sample.','合成起始人數：全校 200 人中 100 人選 A；活動小組 40 人中 36 人選 A。這些固定人數可供紙本比較，並非新抽出的樣本。')}</p>}{teacher&&<ul>{pack.prepare.map(item=><li>{item[locale]}</li>)}</ul>}</section>
    <section class="classroom-sequence" aria-labelledby="classroom-sequence"><h2 id="classroom-sequence">{t('One-class sequence','一節課次序')}</h2><ol>{pack.stages.map(item=><li data-classroom-stage={item.id}><div class="classroom-stage-heading"><span>{item.minutes} {t('min','分鐘')}</span><h3>{item.title[locale]}</h3></div><p>{item.task[locale]}</p>{(teacher||item.id==='implement')&&item.math.map((expression:string)=><MathExpression expression={expression} display/>)}{teacher&&<div class="classroom-teacher-note"><strong>{t('Teacher reasoning / look for','教師推理／觀察重點')}</strong><p>{item.teacher[locale]}</p></div>}</li>)}</ol></section>
    {!teacher&&<section class="classroom-settings" aria-labelledby="classroom-settings" data-classroom-settings={pack.id} data-locale={locale}>
      <h2 id="classroom-settings">{t('Settings to apply manually','手動套用的設定')}</h2><p>{t('This form updates this classroom page and its share link only. It never loads settings into the activity or changes a saved draft.','此表格只更新本課堂頁及分享連結，不會把設定載入活動或改變已存草稿。')}</p>
      <form method="get" action={classroomPackHref(pack.id,locale)} data-classroom-settings-form>
        <label>{t('Comparison case','比較情境')}<select name="preset">{pack.presets.map(item=><option value={item.id}>{item.label[locale]}</option>)}</select></label>
        <label>{t('Experiment seed','實驗種子')}<input name="seed" type="number" min={pack.seed.min} max={pack.seed.max} step="1" value={pack.seed.value}/></label>
        <button class="button secondary" type="submit">{t('Update settings link','更新設定連結')}</button>
      </form>
      <dl class="classroom-setting-values" data-classroom-setting-values>{rows.map(row=><div><dt>{row.label}</dt><dd data-classroom-value={row.key}>{row.value}</dd></div>)}</dl>
      <div class="classroom-share" data-pagefind-ignore><a href={classroomSharePath(pack.id,{},locale)} data-classroom-share-link>{t('Open/share this settings link','開啟／分享此設定連結')}</a><button type="button" class="button secondary" data-classroom-copy>{t('Copy link','複製連結')}</button><label>{t('Share URL — preset and seed only','分享網址——只有情境及種子')}<input type="text" readonly value={classroomSharePath(pack.id,{},locale)} data-classroom-share-url/></label><p class="small" role="status" data-classroom-share-status></p></div>
      <noscript><p>{t('Without JavaScript, use the complete preset list below and enter settings in the tool yourself. The form cannot display a different preset on this static page.','未啟用 JavaScript 時，請用下方完整設定清單，在工具自行輸入；此靜態頁表格不能顯示另一組設定。')}</p></noscript>
    </section>}
    <details class="classroom-preset-list"><summary>{t('All comparison settings','全部比較設定')}</summary>{pack.presets.map(item=><div class="classroom-preset"><h3>{item.label[locale]}</h3><dl class="classroom-setting-values">{classroomSettingRows(pack.id,{preset:item.id},locale).map(row=><div><dt>{row.label}</dt><dd>{row.value}</dd></div>)}</dl></div>)}</details>
    <section class="classroom-engine" aria-labelledby="classroom-engine"><h2 id="classroom-engine">{t('Open the original activity','開啟原活動')}</h2><p>{pack.engine.language[locale]}</p><ol>{pack.engine.launch.map(item=><li>{item[locale]}</li>)}</ol><a class="button" href={classroomEngineHref(pack,locale)} data-classroom-engine>{t('Open','開啟')}{' '}{pack.engine.title[locale]} <span aria-hidden="true">→</span></a><details><summary>{t('Device / Python fallback','裝置／Python 載入失敗時')}</summary><p>{pack.engine.runtime[locale]}</p>{pack.id==='mixing-tank'&&<p><a href="/resources/modeling-workshop/mixing-tank/baseline.csv" download>{t('Precomputed reference CSV','預先生成參照 CSV')}</a>{' · '}<a href="/resources/modeling-workshop/mixing-tank/reference.ipynb" download>{t('Reference notebook','參照 notebook')}</a></p>}</details></section>
    <section aria-labelledby="classroom-output"><h2 id="classroom-output">{t('Keep this evidence','留下這些證據')}</h2><ul>{pack.deliverables.map(item=><li>{item[locale]}</li>)}</ul><p class="classroom-notice">{pack.records[locale]}</p></section>
    <section class="classroom-exit" aria-labelledby="classroom-exit"><h2 id="classroom-exit">{t('Exit question','離堂問題')}</h2><p>{pack.exit[locale]}</p>{teacher&&<div class="classroom-teacher-note"><strong>{t('Reference reasoning','參考推理')}</strong><p>{pack.exitAnswer[locale]}</p></div>}</section>
    {teacher?<section aria-labelledby="classroom-misconceptions"><h2 id="classroom-misconceptions">{t('Misconceptions to discuss','需要討論的誤解')}</h2><ul>{pack.misconceptions.map(item=><li>{item[locale]}</li>)}</ul><p>{t('These statements are misconceptions, not conclusions. Ask for the missing condition or evidence.','以上說法是誤解，並非結論；請學生指出缺少的條件或證據。')}</p></section>:<section class="classroom-worksheet" aria-labelledby="classroom-worksheet"><h2 id="classroom-worksheet">{t('Printable worksheet','可列印工作紙')}</h2><p>{t('Write on a printed copy or keep notes separately. This page has no answer storage. Use the original activity to save digital work.','可在列印版填寫或另外做筆記。本頁不儲存答案；數碼紀錄請沿用原活動。')}</p>{pack.worksheet.map(item=><div class="classroom-worksheet-row"><h3>{item[locale]}</h3><div class="classroom-writing-space" aria-hidden="true"></div></div>)}</section>}
    <details class="classroom-background"><summary>{t('Source and further reading','來源與延伸閱讀')}</summary><p>{pack.provenance[locale]}</p><ul>{pack.background.map(item=><li><a href={`${base}${item.path}`}>{item.label[locale]}</a></li>)}</ul></details>
    <aside class="classroom-print-source"><h2>{t('Activity source','活動來源')}</h2><p>{pack.provenance[locale]}</p><p>{t('This guide','本指引')}：https://skckenneth.github.io{classroomPackHref(pack.id,locale,teacher)}<br/>{t('Original activity','原活動')}：https://skckenneth.github.io{classroomEngineHref(pack,locale)}</p></aside>
    <p class="classroom-back"><a href={`${base}/teaching/classroom-packs/`}>← {t('All one-class activities','全部一節課活動')}</a></p>
  </div>
</div>
<script>
  import { initializeClassroomPage } from '../scripts/classroom-packs';
  document.querySelectorAll<HTMLElement>('[data-classroom-pack], [data-classroom-teacher]').forEach(initializeClassroomPage);
</script>
