---
import map from "../data/generated/workshop-source-map.json";
import {lessons} from "../data/workshop-lessons";
import type {WorkshopLocale} from "../types/workshop";
import "../styles/workshop.css";
const {locale="en"}=Astro.props as {locale:WorkshopLocale};const zh=locale==="zh-Hant";const base=`${zh?"/zh":""}/teaching/modeling-workshop`;
---
<div class="workshop container"><header class="ws-section"><a href={`${base}/`}>← {zh?"學習地圖":"Learning map"}</a><p class="eyebrow">{zh?"教材來源與課程對照":"PROVENANCE & CURRICULUM MAP"}</p><h1>{zh?"每個單元，都連回來源。":"Every unit connects to its sources."}</h1><p>{zh?"20 份書籍及 27 個 Notes 單元的目錄與選段對照；並非宣稱已逐頁審閱所有書籍。掃描版曾作視覺目錄抽查。課內引用另外列出已核對的 PDF 頁與印刷頁。":"A contents-and-selected-passages map of 20 books and 27 Notes units, not a claim of full-page review of every book. Scanned sources received visual contents checks. Lesson citations separately give verified PDF and printed pages."}</p><p>{map.pagePolicy[locale]}</p><p class="ws-small">{zh?"書籍原文、掃描頁與第三方解答不隨網站發佈。模型、程式、案例敘述及教學活動為原創。":"Book text, scanned pages and third-party solutions are not distributed with the site. Models, code, case narratives and activities are original."}</p></header><section class="ws-section"><h2>{zh?"書籍的用途":"How the books are used"}</h2><div class="ws-table-scroll"><table class="ws-source-table"><thead><tr><th>{zh?"書籍":"Book"}</th><th>{zh?"課程用途":"Curriculum role"}</th><th>{zh?"核心工坊":"Core workshops"}</th></tr></thead><tbody>{map.books.map(b=><tr><td>{b.title}<p class="ws-small">{b.pages} {zh?"PDF 頁":"PDF pages"}{b.internalOnly&&(zh?" · 僅供內部核對":" · Internal checking only")}</p></td><td>{b.role[locale]}</td><td>{b.workshops.length?b.workshops.map(id=>{const l=lessons.find(l=>l.id===id)!;return <a style="display:block" href={`${base}/${l.slug}/`}>{l.number} · {l.title[locale]}</a>}):(zh?"先備／進階閱讀":"Prerequisite / advanced reading")}</td></tr>)}</tbody></table></div></section><section class="ws-section"><h2>{zh?"全部 27 個 Notes 單元":"All 27 Notes units"}</h2><div class="ws-table-scroll"><table class="ws-source-table"><thead><tr><th>{zh?"Notes 單元":"Notes unit"}</th><th>{zh?"對應工坊":"Matching workshops"}</th></tr></thead><tbody>{map.notes.map(n=><tr><td><a href={`${zh?"/zh":""}/teaching/mathematical-modeling-lecture-programme/${n.id}/`}>{n.title[locale]}</a></td><td>{n.workshops.map(id=>{const l=lessons.find(l=>l.id===id)!;return <a style="margin-right:.75rem" href={`${base}/${l.slug}/`}>{l.number}</a>})}</td></tr>)}</tbody></table></div></section></div>
