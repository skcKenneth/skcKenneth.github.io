---
import {examCoverage,lessonById,label,lessonUrl} from '../data/senior-math/catalog.mjs';
const {locale='en'}=Astro.props,zh=locale==='zh-Hant';
---
{examCoverage.map(exam=><section class="senior-exam-map"><h2>2027 {exam.code} · {zh?'範圍與課節對照':'Syllabus and lesson mapping'}</h2>{exam.inherits.length>0&&<p>{zh?'JM02 包括 JM01 全部範圍，再加以下九項。':'JM02 includes the complete JM01 syllabus, together with these nine additional areas.'}</p>}<div class="senior-grid">{exam.areas.map(area=><article class="senior-card"><span class="eyebrow">{exam.code} {area.number} · PDF {area.pdfPage}</span><h3>{label(area.title,locale)}</h3><ul>{area.lessonIds.map((id:string)=>lessonById.get(id)).filter(Boolean).map((lesson:any)=><li><a href={lessonUrl(lesson.id,locale)}>{label(lesson.title,locale)}</a>{exam.code==="JM01"&&lesson.id==="sup-matrices"&&<small> · {zh?"只取一次方程組；矩陣及行列式屬 JM02":"Linear systems only; matrices and determinants belong to JM02"}</small>}{exam.code==="JM02"&&lesson.id==="s2-5-2"&&<small> · {zh?"大綱要求多項式的和、差、積、商求導；指數、對數、三角求導屬課程延伸":"Syllabus: sums, differences, products and quotients of polynomials; exponential, logarithmic and trigonometric derivatives are curriculum extensions"}</small>}</li>)}</ul></article>)}</div></section>)}
