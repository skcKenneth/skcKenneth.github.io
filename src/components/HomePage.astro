---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReaderCard from './ReaderCard.astro';
import TopicIcon from './TopicIcon.astro';
import '../styles/reader.css';
import '../styles/editorial-home.css';
import { selectLatestWriting } from '../lib/latest-writing.mjs';
import { TOPICS, START_HERE, getTopicIds, canonicalId, readingMinutes, articleType, localeBase } from '../data/site-reader.mjs';
interface Props { locale?:'en'|'zh-Hant'; }
const {locale='en'}=Astro.props;
const zh=locale==='zh-Hant',base=localeBase(locale);
const writingCollection=await getCollection(zh?'writingZh':'writing',({data})=>!data.draft&&!data.archived);
const writing = selectLatestWriting(writingCollection);
const latestIds=new Set(writing.map(item=>canonicalId(item.data)));
const start=START_HERE.map(id=>writingCollection.find(e=>canonicalId(e.data)===id)).filter((entry):entry is NonNullable<typeof entry>=>Boolean(entry)&&!latestIds.has(canonicalId(entry!.data)));
const t=(en:string,ch:string)=>zh?ch:en;
---
<BaseLayout title={t('Mathematics, models, and ideas.','用數學，看清問題。')} description={t('A personal notebook on mathematics, computation and teaching, by Kenneth Cheng in Macau.','Kenneth Cheng 的個人知識網誌：由數學、計算到教學，在澳門記錄探索與思考。')} locale={locale} alternatePath={zh?'/':'/zh/'}>
<div class="editorial-home">
<section class="reader-home-hero"><div class="container reader-hero-grid">
  <div class="reader-hero-copy"><p class="eyebrow">Kenneth Cheng · {zh?'澳門':'Macau'}</p><h1>{zh?'用數學，':'Mathematics,'}<br/>{zh?'看清問題。':'with curiosity.'}</h1><p class="reader-home-lead">{t('I teach mathematics and explore how models help us understand the world. A notebook of questions, computations, and classroom ideas.','我教數學，也研究模型如何幫助我們理解世界。這裡記錄問題、計算，以及課堂內外的思考。')}</p><div class="actions"><a class="button" href={base+'/writing/'}>{t('Explore writing','探索文章')} <span aria-hidden="true">↗</span></a><a class="button secondary" href="#start-here">{t('Start here','第一次來')}</a></div><a class="reader-hero-about" href={base+'/about/'}>{t('A little about me','認識我多一點')} →</a></div>
  <div class="reader-hero-art" aria-hidden="true"><svg viewBox="0 0 360 270" width="360" height="270" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="35" y="24" width="290" height="222" rx="28" fill="#e8eee7"/><circle cx="183" cy="137" r="83" fill="#eee7d8"/><path d="M52 184C106 184 92 78 160 78S217 201 301 201" stroke="#1f6652" stroke-width="8" stroke-linecap="round"/><path d="M62 88C145 88 133 195 204 195S242 73 307 73" stroke="#7c9c89" stroke-width="8" stroke-linecap="round"/><path d="M82 226L152 44L279 155L82 226Z" stroke="#1f6652" stroke-width="2" stroke-dasharray="5 8"/><circle cx="160" cy="78" r="12" fill="#1f6652" stroke="#f5f3ed" stroke-width="5"/><circle cx="204" cy="195" r="12" fill="#a56d47" stroke="#f5f3ed" stroke-width="5"/><circle cx="279" cy="155" r="8" fill="#1f6652"/><circle cx="82" cy="226" r="8" fill="#a56d47"/></svg><p>{t('Follow a question. See where it leads.','沿著一個問題，看看它帶你去哪裡。')}</p></div>
</div></section>
<section class="reader-home-section" id="latest-writing"><div class="container"><div class="reader-section-heading"><div><p class="eyebrow">{t('Fresh from the notebook','最近寫下')}</p><h2>{t('Latest writing','最新文章')}</h2></div><a class="text-link" href={base+'/writing/'}>{t('All writing','全部文章')} →</a></div><div class="editorial-latest-grid">{writing.map((item,index)=><ReaderCard entry={item} locale={locale} variant={index===0?'feature':'compact'} headingLevel={3} eager={index===0}/>)}</div></div></section>
<section class="reader-home-section reader-start" id="start-here"><div class="container"><div class="reader-section-heading"><div><p class="eyebrow">{t('A few good starting points','給第一次到訪的你')}</p><h2>{t('Start with a question.','可以由這幾篇開始。')}</h2></div><p>{t('From a modeling question to a calculation and an application.','由建模問題，走到計算方法與實際應用。')}</p></div><ol class="reader-start-list">{start.map((item,index)=><li><span aria-hidden="true">0{index+1}</span><div><p class="meta-line">{articleType(item.data.type,locale)} · {readingMinutes(item,locale)} {t('min','分鐘')}</p><h3><a href={base+'/writing/'+item.data.slug+'/'}>{item.data.title}</a></h3><p>{item.data.summary}</p></div><a class="start-arrow" href={base+'/writing/'+item.data.slug+'/'} aria-label={item.data.title}>↗</a></li>)}</ol><a class="reader-path-shortcut" href={base+'/topics/routes/model-trust/'}><span><strong>{t('When can we trust a model?','甚麼時候可以相信模型？')}</strong><span>{t('Explore evidence, uncertainty, and the limits of a conclusion.','由證據、不確定性與結論的界限，繼續讀下去。')}</span></span><span aria-hidden="true">→</span></a></div></section>
<section class="reader-home-section"><div class="container"><div class="reader-section-heading"><div><p class="eyebrow">{t('Choose a direction','跟隨興趣')}</p><h2>{t('Explore by topic','按主題探索')}</h2></div><a class="text-link" href={base+'/topics/'}>{t('All topics','全部主題')} →</a></div><div class="reader-topic-grid">{TOPICS.map(topic=><a class="reader-topic-tile" href={base+'/topics/'+topic.id+'/'}><TopicIcon topicId={topic.id}/><h3>{topic.label[locale]}</h3><p>{topic.description[locale]}</p><span>{writingCollection.filter(e=>getTopicIds(e.data).includes(topic.id)).length} {t('articles','篇文章')} <b aria-hidden="true">→</b></span></a>)}</div></div></section>
<section class="reader-home-section reader-teaching-promo"><div class="container reader-teaching-inner"><div><p class="eyebrow">{t('From reading to doing','由閱讀走向實踐')}</p><h2>{t('Bring a question into the classroom.','把問題帶進課堂。')}</h2><p>{t('Interactive models, mathematics practice, and bilingual teaching resources.','互動模型、數學練習及雙語教材。')}</p></div><div class="actions"><a class="button" href={base+'/teaching/'}>{t('Learning resources','學習資源')} →</a><a class="button secondary" href={base+'/teaching/model-laboratory/'}>{t('Try a model','試玩互動模型')}</a></div></div></section>
</div></BaseLayout>
