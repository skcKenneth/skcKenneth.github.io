---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { selectLatestWriting } from '../lib/latest-writing.mjs';
import { TOPICS, START_HERE, getTopicIds, canonicalId, readingMinutes, articleType, localeBase } from '../data/site-reader.mjs';
interface Props { locale?:'en'|'zh-Hant'; }
const {locale='en'}=Astro.props;
const zh=locale==='zh-Hant',base=localeBase(locale);
const writingCollection=await getCollection(zh?'writingZh':'writing',({data})=>!data.draft&&!data.archived);
const writing = selectLatestWriting(writingCollection);
const start=START_HERE.map(id=>writingCollection.find(e=>canonicalId(e.data)===id)).filter((entry):entry is NonNullable<typeof entry>=>Boolean(entry));
const t=(en:string,ch:string)=>zh?ch:en;
---
<BaseLayout title={t('Mathematics, models, and ideas.','用數學，看清問題。')} description={t('A personal notebook on mathematics, computation and teaching, by Kenneth Cheng in Macau.','Kenneth Cheng 的個人知識網誌：由數學、計算到教學，在澳門記錄探索與思考。')} locale={locale} alternatePath={zh?'/':'/zh/'}>
<section class="reader-home-hero"><div class="container reader-hero-grid">
<div><p class="eyebrow">Kenneth Cheng · {zh?'澳門':'Macau'}</p><h1>{zh?'用數學，':'Mathematics,'}<br/>{zh?'看清問題。':'with curiosity.'}</h1><p class="reader-home-lead">{t('I teach mathematics and explore how models help us understand the world. Here I share questions, computations, and ideas worth thinking through.','我教數學，也研究模型如何幫助我們理解世界。這裡記錄值得追問的問題、計算實驗，以及課堂內外的思考。')}</p><div class="actions"><a class="button" href={base+'/writing/'}>{t('Explore the writing','探索文章')} <span aria-hidden="true">↗</span></a><a class="button secondary" href="#start-here">{t('Start here','第一次來，由這裡開始')}</a></div></div>
<aside class="reader-welcome" aria-label={t('A note for new readers','給新讀者的話')}><img src="/images/kenneth-woven-knot.svg" width="160" height="160" alt=""/><p class="eyebrow">{t('Follow a question','沿著問題探索')}</p><p>{t('You do not need to start with the equations. Start with a question that makes you curious.','不必由公式開始。先找一個令你感到好奇的問題。')}</p><a href={base+'/about/'}>{t('A little about me','認識我多一點')} →</a></aside>
</div></section>
<section class="reader-home-section" id="latest-writing"><div class="container"><div class="reader-section-heading"><div><p class="eyebrow">{t('Fresh from the notebook','最近寫下')}</p><h2>{t('Latest writing','最新文章')}</h2></div><a class="text-link" href={base+'/writing/'}>{t('All writing','全部文章')} →</a></div><div class="reader-home-cards">
{writing.map((item,index)=><article class="reader-home-card"><a class="writing-feature-image" href={base+'/writing/'+item.data.slug+'/'} aria-label={item.data.title}><img src={item.data.heroImage?'/images/reader-thumbs/'+canonicalId(item.data)+'.webp':'/images/kenneth-woven-knot.svg'} alt="" width="640" height="400" loading={index===0?'eager':'lazy'} decoding="async"/></a><div class="reader-card-copy"><p class="meta-line"><span>{item.data.date?.toLocaleDateString(zh?'zh-Hant-TW':'en-GB',{year:'numeric',month:'short',day:'numeric'})}</span><span>{readingMinutes(item,locale)} {t('min read','分鐘閱讀')}</span></p><h3><a href={base+'/writing/'+item.data.slug+'/'}>{item.data.title}</a></h3><p>{item.data.summary}</p><a class="text-link" href={base+'/writing/'+item.data.slug+'/'}>{t('Read article','閱讀文章')} →</a></div></article>)}
</div></div></section>
<section class="reader-home-section reader-start" id="start-here"><div class="container"><div class="reader-section-heading"><div><p class="eyebrow">{t('A few good starting points','給第一次到訪的你')}</p><h2>{t('Start with a question.','可以由這幾篇開始。')}</h2></div><p>{t('Three short introductions to how I think about models.','三篇入門選讀，認識我如何理解模型。')}</p></div><ol class="reader-start-list">{start.map((item,index)=><li><span aria-hidden="true">0{index+1}</span><div><p class="meta-line">{articleType(item.data.type,locale)} · {readingMinutes(item,locale)} {t('min','分鐘')}</p><h3><a href={base+'/writing/'+item.data.slug+'/'}>{item.data.title}</a></h3><p>{item.data.summary}</p></div><a class="start-arrow" href={base+'/writing/'+item.data.slug+'/'} aria-label={item.data.title}>↗</a></li>)}</ol></div></section>
<section class="reader-home-section"><div class="container"><div class="reader-section-heading"><div><p class="eyebrow">{t('Choose a direction','跟隨興趣')}</p><h2>{t('Explore by topic','按主題探索')}</h2></div><a class="text-link" href={base+'/topics/'}>{t('All topics','全部主題')} →</a></div><div class="reader-topic-grid">{TOPICS.map(topic=><a class="reader-topic-tile" href={base+'/topics/'+topic.id+'/'}><h3>{topic.label[locale]}</h3><p>{topic.description[locale]}</p><span>{writingCollection.filter(e=>getTopicIds(e.data).includes(topic.id)).length} {t('articles','篇文章')} <b aria-hidden="true">→</b></span></a>)}</div></div></section>
<section class="reader-home-section reader-teaching-promo"><div class="container"><p class="eyebrow">{t('From reading to doing','由閱讀走向實踐')}</p><h2>{t('Bring a question into the classroom.','把問題帶進課堂。')}</h2><p class="lead">{t('Interactive models, mathematics practice and bilingual teaching resources, organized for students and teachers.','互動模型、數學練習及雙語教材，按學生與教師的需要整理。')}</p><div class="actions"><a class="button" href={base+'/teaching/'}>{t('Find learning resources','尋找學習資源')} →</a><a class="button secondary" href={base+'/teaching/model-laboratory/'}>{t('Try a model','試玩互動模型')}</a></div></div></section>
</BaseLayout>
