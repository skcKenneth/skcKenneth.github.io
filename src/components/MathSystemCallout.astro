---
import {lessons} from '../data/workshop-lessons';
import {createMathCatalog} from '../lib/math-system-catalog.mjs';
const {locale='en'}=Astro.props;
const zh=locale==='zh-Hant',base=zh?'/zh':'';
const classroomModules=import.meta.glob('../data/classroom-packs.mjs',{eager:true}) as Record<string,{CLASSROOM_PACKS:any[]}>;
const count=createMathCatalog(lessons,Object.values(classroomModules)[0]?.CLASSROOM_PACKS||[]).length;
---
<section class="section math-system-callout" id="mathematics-learning-space"><div class="container">
 <p class="eyebrow">{zh?'數學互動・統一研習空間':'INTERACTIVE MATHEMATICS · ONE WORKSPACE'}</p>
 <h2>{zh?'由初中探究，走到高中與研究模型。':'From school inquiry to senior mathematics and research models.'}</h2>
 <p>{zh?'在同一空間操作課節、探究實驗、聯考練習、Python 工坊及建模活動，安排課堂流程，查看原有學習紀錄並匯出完整備份。':'Work with lessons, inquiry labs, JAE practice, Python workshops and modeling activities in one space; plan a classroom sequence, review original learning records and export a complete backup.'}</p>
 <p class="small">{zh?`${count} 項活動與資源；沿用原有學習紀錄。`:`${count} activities and resources; original learning records preserved.`}</p>
 <div class="actions"><a class="button" href={`${base}/teaching/math/`}>{zh?'進入數學互動研習室':'Open the mathematics learning space'}</a><a class="button secondary" href={`${base}/teaching/math/?activity=school%3Ainquiry%3Aangle-bisector`}>{zh?'初二：角的平分線・18 分鐘探究':'Year 8: angle bisectors · 18-minute inquiry'}</a></div>
</div></section>
<style>.math-system-callout{background:var(--surface);border-bottom:1px solid var(--line)}.math-system-callout p{max-width:80ch}.math-system-callout h2{max-width:32ch}</style>
