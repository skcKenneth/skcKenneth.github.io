---
import {chapterTitle,chapterSubtitle,functionWorksheets,worksheetBase,worksheetUrl,worksheetActivityId} from '../data/function-worksheets.mjs';
import {worksheetControls,worksheetScene} from '../lib/function-worksheet-models.mjs';
import MathExpression from './MathExpression.astro';
import 'katex/dist/katex.min.css';
import '../styles/function-worksheets.css';
interface Props {locale?:'en'|'zh-Hant';lessonId?:string}
const {locale='en',lessonId}=Astro.props;
const zh=locale==='zh-Hant',t=(en:string,ch:string)=>zh?ch:en,l=(value:any)=>value?.[locale]||'';
const lesson:any=functionWorksheets.find((item:any)=>item.id===lessonId),index=functionWorksheets.indexOf(lesson);
const previousLesson=index>0?functionWorksheets[index-1]:undefined;
const nextLesson=index>=0&&index+1<functionWorksheets.length?functionWorksheets[index+1]:undefined;
const controls:any[]=lesson?worksheetControls(lesson.id):[];
const defaults=Object.fromEntries(controls.map(c=>[c.key,c.value]));
const scene:any=lesson?worksheetScene(lesson.id,defaults,locale):null;
const workspace=`${zh?'/zh':''}/teaching/math/`;
const classroom=new URLSearchParams({view:'classroom',title:l(chapterTitle)});
functionWorksheets.forEach((item:any)=>classroom.append('a',worksheetActivityId(item.id)));
const stages=[t('Predict','先預測'),t('Explore','操作與記錄'),t('Explain','整理與說理'),t('Transfer','遷移與檢核')];
const groups=[{title:t('Inputs, rules and representations','輸入、規則與表示'),ids:['01','02','03','04','05','06','07']},{title:t('Properties and powers','性質與冪函數'),ids:['08','09','10','11','12']},{title:t('Composition and decisions','複合與選擇'),ids:['13','14']}];
const relatedNames:Record<string,string>={'c1-3-1':t('Function concepts','函數概念'),'c1-3-2':t('Function properties','函數性質'),'c1-3-3':t('Power functions','冪函數'),'c1-3-4':t('Function applications','函數應用')};
---
<div class="function-chapter" lang={locale} data-function-chapter={!lesson?true:undefined} data-function-worksheet={lesson?.id} data-fw-locale={locale}>
 <div class="fw-screen">
  <header class="container fw-heading">
   <a class="fw-back" href={lesson?worksheetBase(locale):workspace}>← {lesson?l(chapterTitle):t('Mathematics learning space','數學互動研習室')}</a>
   <p class="fw-eyebrow">{lesson?l(chapterTitle):t('SENIOR 1 · THINK TOGETHER','高一・一起思考')}</p>
   <h1>{lesson?l(lesson.title):l(chapterTitle)}</h1>
   <p class="fw-lead">{lesson?l(lesson.focus):l(chapterSubtitle)}</p>
   <nav class="fw-toolbar" aria-label={t('Chapter tools','章節工具')}>
    {lesson?<>
     <a data-fw-open-workspace target="_top" href={`${workspace}?activity=${encodeURIComponent(worksheetActivityId(lesson.id))}`}>{t('Open in classroom workspace','在研習室開啟')}</a>
     <button type="button" data-fw-project aria-pressed="false">{t('Projection mode','投影模式')}</button>
     <button type="button" data-fw-reset>{t('Reset this lesson','重設本課')}</button>
     <button type="button" data-fw-print="student">{t('Print observation sheet','列印探究記錄頁')}</button>
     <button type="button" data-fw-print="teacher">{t('Print teacher reference','列印教師參考')}</button>
    </>:<>
     <a class="fw-primary" href={worksheetUrl('01',locale)}>{t('Begin with mappings','由對應開始')}</a>
     <a target="_top" href={`${workspace}?${classroom}`}>{t('Open the chapter classroom sequence','開啟整章課堂流程')}</a>
    </>}
   </nav>
  </header>
  {!lesson?<div class="container fw-overview">
   <section class="fw-invitation"><div><p class="fw-eyebrow">{t('PAPER · PROJECTION · DISCUSSION','紙本・投影・討論')}</p><h2>{t('Make a prediction. Change a condition. Explain why.','先想一想，改一個條件，再講清楚理由。')}</h2><p>{t('Keep your paper worksheet beside you. Your teacher operates the model; you record evidence, compare ideas and return to the definition.','保留手上嘅紙本學習單。由教師操作模型，你記錄證據、比較想法，再回到數學定義。')}</p></div><div class="fw-chapter-mark" aria-hidden="true"><span>f</span><small>x → y</small></div></section>
   {groups.map(group=><section class="fw-course-group"><h2>{group.title}</h2><div class="fw-course-grid">{functionWorksheets.filter((item:any)=>group.ids.includes(item.id)).map((item:any)=><article class="fw-course-card"><h3><a href={worksheetUrl(item.id,locale)}>{l(item.title)}</a></h3><p>{l(item.question)}</p><a class="fw-card-link" href={worksheetUrl(item.id,locale)}>{t('Open lesson','開啟課節')} <span aria-hidden="true">↗</span></a></article>)}</div></section>)}
   <section class="fw-chapter-notes"><h2>{t('A lesson with room to think','留有思考空間嘅一課')}</h2><p>{t('A suggested 40-minute lesson: 5 minutes for prediction, 12 for exploration, 8 for reasoning, 12 for paper practice and 3 for an exit task. Each lesson includes teacher questions and a printable observation sheet.','建議一課 40 分鐘：預測 5 分鐘、探究 12 分鐘、說理 8 分鐘、紙本練習 12 分鐘、課末檢核 3 分鐘。每課附教師追問及可列印探究記錄頁。')}</p><p>{t('All eight models work without a sign-in. Classroom notes and backups use the existing learning workspace. Paper responses remain each student’s own evidence.','八組模型均免登入使用；課堂筆記與備份沿用現有研習室工具。紙上作答保留每位學生自己嘅學習證據。')}</p></section>
  </div>:<article class="container fw-lesson" data-fw-lesson={lesson.id} data-fw-stage="0">
   <nav class="fw-stages" aria-label={t('Inquiry stages','探究步驟')}>{stages.map((stage,i)=><button type="button" data-fw-stage-button={i} aria-current={i===0?'step':undefined}><span aria-hidden="true">{i+1}</span>{stage}</button>)}</nav>
   <section class="fw-question"><p class="fw-eyebrow">{t('OUR QUESTION','本課問題')}</p><h2>{l(lesson.question)}</h2></section>
   <section class="fw-stage-content" data-fw-show-stages="0"><h3>{t('Commit to an idea before seeing the result','睇結果之前，先留下自己嘅想法')}</h3><p class="fw-prediction">{l(lesson.prediction)}</p><div class="fw-paper-prompt"><b>{t('Write on your paper','喺紙上記錄')}</b><p>{t('I predict … because … . What observation would make me change my mind?','我預測……，因為……。出現甚麼結果時，我會修改想法？')}</p></div><button type="button" class="fw-primary" data-fw-next>{t('We have a prediction →','已有預測，開始觀察 →')}</button></section>
   <section class="fw-model fw-stage-content" data-fw-show-stages="1,2" hidden aria-labelledby="fw-model-title">
    <div class="fw-section-head"><h3 id="fw-model-title">{t('Change one condition at a time','一次改一個條件')}</h3><span>{t('Teacher operates · everyone records','教師操作・全班記錄')}</span></div>
    <div class="fw-model-layout"><div class="fw-diagram"><svg viewBox="0 0 800 440" role="img" aria-label={t('Interactive function diagram','函數互動圖示')} data-fw-svg set:html={scene.svg}/></div><form class="fw-controls" onsubmit="return false" aria-label={t('Model controls','模型操作')}>
     {controls.map(control=><label for={`fw-control-${control.key}`} data-fw-control-label={control.key}><span>{l(control.label)}</span>{control.type==='select'?<select id={`fw-control-${control.key}`} data-fw-control={control.key}>{control.options.map((option:any)=><option value={option.value} selected={String(option.value)===String(control.value)}>{l(option.label)}</option>)}</select>:<><output for={`fw-control-${control.key}`} data-fw-output={control.key}>{control.value}</output><input id={`fw-control-${control.key}`} type={control.type} data-fw-control={control.key} min={control.min} max={control.max} step={control.type==='number'&&control.step!==1?'any':control.step} value={control.value}/></>}</label>)}
     <p class="fw-input-error" data-fw-error role="alert"></p>
    </form></div>
    <p class="fw-result" data-fw-summary aria-live="polite">{scene.summary}</p>
    <div class="fw-table-wrap"><table class="fw-table" data-fw-table><caption>{t('Values for this setting','目前設定嘅數值')}</caption><thead><tr>{scene.headers.map((value:string)=><th scope="col">{value}</th>)}</tr></thead><tbody>{scene.rows.map((row:any[])=><tr>{row.map(value=><td>{value}</td>)}</tr>)}</tbody></table></div>
    <button type="button" data-fw-capture>{t('Keep this observation on the board','把這筆觀察留喺畫面')}</button><button type="button" data-fw-export>{t('Download board observations','下載課堂觀察')}</button>
    <p class="fw-small">{t('Board observations stay in this open page. For saved notes, open this activity in the learning workspace and choose whether to save its notebook.','畫面觀察暫留喺本次頁面。如需保存筆記，可在研習室開啟本活動，再選擇保存共用筆記。')}</p>
    <ol class="fw-observations" data-fw-observations aria-live="polite"></ol>
    <div class="fw-paper-prompt"><b>{t('Collect evidence on paper','喺紙上收集證據')}</b><ol>{lesson.evidence.map((value:any)=><li>{l(value)}</li>)}</ol></div>
    <button type="button" class="fw-primary" data-fw-next data-fw-show-stages="1">{t('We have evidence →','已有證據，嘗試解釋 →')}</button>
   </section>
   <section class="fw-stage-content" data-fw-show-stages="2" hidden><h3>{t('An observation, a counterexample, or a general argument?','呢個係觀察、反例，定一般說理？')}</h3><p>{t('Discuss your reason before opening the hints. A few successful tests support a conjecture; a proof must cover every allowed input.','先討論理由，再開提示。幾次成功測試可以支持猜想；證明要涵蓋所有允許輸入。')}</p>
    <div class="fw-hints">{lesson.hints.map((hint:any,i:number)=><details data-fw-hint><summary>{t(`Hint ${i+1}`,`提示 ${i+1}`)}</summary><p>{l(hint)}</p></details>)}</div>
    <details class="fw-reasoning" data-fw-answer><summary>{t('Reveal the reasoning','展開參考說理')}</summary><p>{l(lesson.explanation)}</p><ul data-fw-reasoning-facts>{scene.facts.map((fact:string)=><li>{fact}</li>)}</ul></details>
    <div class="fw-examples">{lesson.workedExamples.map((example:any)=><article><h4>{l(example.prompt)}</h4><MathExpression expression={example.expression} display/><details data-fw-answer><summary>{t('Reveal the steps','逐步核對解法')}</summary><ol>{example.steps.map((step:any)=><li>{l(step)}</li>)}</ol></details></article>)}</div>
    <button type="button" class="fw-primary" data-fw-next>{t('Try a new case →','用喺新例子 →')}</button>
   </section>
   <section class="fw-stage-content" data-fw-show-stages="3" hidden><h3>{t('Carry the idea to a new case','將本課想法帶到新例子')}</h3><p>{l(lesson.transfer)}</p><article class="fw-exit"><p class="fw-eyebrow">{t('EXIT TASK · 3 MINUTES','課末檢核・3 分鐘')}</p><h4>{l(lesson.exit.prompt)}</h4><p>{t('Write your answer and a reason on paper.','喺紙上寫答案，並交代一個理由。')}</p><details data-fw-answer><summary>{t('Teacher reference and reasoning checklist','教師參考與說理清單')}</summary><p>{l(lesson.exit.answer)}</p><ul>{lesson.exit.rubric.map((value:any)=><li>{l(value)}</li>)}</ul></details></article></section>
   <div class="fw-step-footer"><button type="button" data-fw-prev disabled>{t('← Previous stage','← 上一步')}</button><p data-fw-stage-status role="status">{stages[0]}</p><button type="button" data-fw-advance>{t('Next stage →','下一步 →')}</button></div>
   <details class="fw-teacher" id="teacher"><summary>{t('Teacher preparation and paper cross-reference','教師備課與紙本對照')}</summary><p>{lesson.sourceSection} · {lesson.sourceFilename}</p><p>{l(lesson.teacher.timing)}</p>{[['prompts',t('Questions to ask','課堂追問')],['anticipated',t('Expected responses','預期回應')],['pitfalls',t('Listen for these confusions','留意嘅混淆')],['board',t('Board plan','板書重點')]].map(([key,title])=><section><h3>{title}</h3><ul>{lesson.teacher[key].map((value:any)=><li>{l(value)}</li>)}</ul></section>)}</details>
   <nav class="fw-related" aria-label={t('Revisit the idea','補充重溫')}><span>{t('Revisit:','延伸重溫：')}</span>{lesson.relatedLessons.map((id:string)=><a href={`${zh?'/zh':''}/teaching/senior-math/lessons/${id}/`}>{relatedNames[id]||id}</a>)}</nav>
   <nav class="fw-lesson-navigation" aria-label={t('Previous and next lessons','前後課節')}>{previousLesson?<a href={worksheetUrl(previousLesson.id,locale)}>← {l(previousLesson.title)}</a>:<span/>}{nextLesson&&<a href={worksheetUrl(nextLesson.id,locale)}>{l(nextLesson.title)} →</a>}</nav>
   <noscript><p>{t('Interactive controls and stage navigation need JavaScript. The printable observation sheet and teacher reference below remain readable.','操作及分步導航需要 JavaScript；下方探究記錄頁及教師參考仍可閱讀。')}</p><style>{`@media screen{.function-chapter .fw-print{display:block!important}}.function-chapter .fw-model,.function-chapter .fw-stages,.function-chapter .fw-step-footer{display:none!important}`}</style></noscript>
  </article>}
 </div>
 {lesson&&<>
 <section class="fw-print" data-fw-print-student hidden><header><p>{l(chapterTitle)}</p><h2 class="fw-print-title">{l(lesson.title)}</h2><p>{t('Class ______ Name __________________ Date __________','班別 ______ 姓名 __________________ 日期 __________')}</p></header><h2>{l(lesson.question)}</h2><h3>{t('My prediction and reason','我的預測與理由')}</h3><p>{l(lesson.prediction)}</p><div class="fw-writing-lines"/><h3>{t('Evidence and observations','證據與觀察')}</h3>{lesson.evidence.map((value:any)=><div><p>{l(value)}</p><div class="fw-writing-lines"/></div>)}<h3>{t('Explain or give a counterexample','解釋或提出反例')}</h3><div class="fw-writing-lines"/><h3>{t('Transfer','遷移')}</h3><p>{l(lesson.transfer)}</p><div class="fw-writing-lines"/><h3>{t('Exit task','課末檢核')}</h3><p>{l(lesson.exit.prompt)}</p><div class="fw-writing-lines"/></section>
 <section class="fw-print" data-fw-print-teacher hidden><header><p>{l(chapterTitle)} · {t('Teacher reference','教師參考')}</p><h2 class="fw-print-title">{l(lesson.title)}</h2><p>{lesson.sourceSection} · {lesson.sourceFilename}</p></header><p>{l(lesson.teacher.timing)}</p><h2>{l(lesson.question)}</h2><p>{l(lesson.prediction)}</p><h3>{t('Evidence tasks','證據任務')}</h3><ol>{lesson.evidence.map((value:any)=><li>{l(value)}</li>)}</ol><h3>{t('Reference reasoning','參考說理')}</h3><p>{l(lesson.explanation)}</p>{lesson.workedExamples.map((example:any)=><article><h3>{l(example.prompt)}</h3><MathExpression expression={example.expression} display/><ol>{example.steps.map((value:any)=><li>{l(value)}</li>)}</ol></article>)}<h3>{t('Transfer and exit task','遷移與課末檢核')}</h3><p>{l(lesson.transfer)}</p><p>{l(lesson.exit.prompt)}</p><p>{l(lesson.exit.answer)}</p><ul>{lesson.exit.rubric.map((value:any)=><li>{l(value)}</li>)}</ul>{[['prompts',t('Questions','追問')],['anticipated',t('Expected responses','預期回應')],['pitfalls',t('Confusions','混淆')],['board',t('Board plan','板書')]].map(([key,title])=><section><h3>{title}</h3><ul>{lesson.teacher[key].map((value:any)=><li>{l(value)}</li>)}</ul></section>)}</section>
 </>}
</div>
<script>
 import {initializeFunctionWorksheets} from '../scripts/function-worksheet-ui';
 document.querySelectorAll<HTMLElement>('[data-function-worksheet]').forEach(initializeFunctionWorksheets);
</script>
