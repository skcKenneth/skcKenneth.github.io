---
import {chapterTitle,chapterSubtitle,functionWorksheets,worksheetBase,worksheetUrl,worksheetActivityId} from '../data/function-worksheets.mjs';
import {createDirectState,renderDirectScene} from '../lib/function-hands-on.mjs';
import MathExpression from './MathExpression.astro';
import MathText from './MathText.astro';
import 'katex/dist/katex.min.css';
import '../styles/function-worksheets.css';
interface Props {locale?:'en'|'zh-Hant';lessonId?:string}
const {locale='en',lessonId}=Astro.props;
const zh=locale==='zh-Hant',t=(en:string,ch:string)=>zh?ch:en,l=(value:any)=>value?.[locale]||'';
const lesson:any=functionWorksheets.find((item:any)=>item.id===lessonId),index=functionWorksheets.indexOf(lesson);
const previousLesson=index>0?functionWorksheets[index-1]:undefined;
const nextLesson=index>=0&&index+1<functionWorksheets.length?functionWorksheets[index+1]:undefined;
const scene:any=lesson?renderDirectScene(lesson.id,createDirectState(lesson.id),locale):null;
const workspace=`${zh?'/zh':''}/teaching/math/`;
const classroom=new URLSearchParams({view:'classroom',title:l(chapterTitle)});
functionWorksheets.forEach((item:any)=>classroom.append('a',worksheetActivityId(item.id)));
const stages=[t('Predict','先預測'),t('Explore','操作與記錄'),t('Explain','整理與說理'),t('Transfer','遷移與檢核')];
const groups=[{title:t('Inputs, rules and representations','輸入、規則與表示'),ids:['01','02','03','04','05','06','07']},{title:t('Properties and powers','性質與冪函數'),ids:['08','09','10','11','12']},{title:t('Composition and decisions','複合與選擇'),ids:['13','14']}];
const relatedNames:Record<string,string>={'c1-3-1':t('Function concepts','函數概念'),'c1-3-2':t('Function properties','函數性質'),'c1-3-3':t('Power functions','冪函數'),'c1-3-4':t('Function applications','函數應用')};
---
<div class="function-chapter" lang={locale} data-function-chapter={!lesson?true:undefined} data-function-worksheet={lesson?.id} data-fw-locale={locale}>
 <div class="fw-screen">
  <header class:list={["container","fw-heading",{"fw-lesson-heading":!!lesson}]}>
   <a class="fw-back" href={lesson?worksheetBase(locale):workspace}>← {lesson?l(chapterTitle):t('Mathematics learning space','數學互動研習室')}</a>
   <p class="fw-eyebrow">{lesson?l(chapterTitle):t('SENIOR 1 · THINK TOGETHER','高一・一起思考')}</p>
   <h1>{lesson?l(lesson.title):l(chapterTitle)}</h1>
   <p class="fw-lead">{lesson?l(lesson.focus):l(chapterSubtitle)}</p>
   <nav class="fw-toolbar" aria-label={t('Chapter tools','章節工具')}>
    {lesson?<>
     <a data-fw-open-workspace target="_top" href={`${workspace}?activity=${encodeURIComponent(worksheetActivityId(lesson.id))}`}>{t('Open in classroom workspace','在研習室開啟')}</a>
     <button type="button" data-fw-project aria-pressed="false">{t('Projection mode','投影模式')}</button>
     <button type="button" data-fw-reset>{t('Reset this lesson','重設本課')}</button>
     <button type="button" data-fw-print="student">{t('Print observation sheet','列印探究記錄頁')}</button>
     <button type="button" data-fw-print="teacher">{t('Print teacher reference','列印教師參考')}</button>
    </>:<>
     <a class="fw-primary" href={worksheetUrl('01',locale)}>{t('Begin with mappings','由對應開始')}</a>
     <a target="_top" href={`${workspace}?${classroom}`}>{t('Open the chapter classroom sequence','開啟整章課堂流程')}</a>
    </>}
   </nav>
  </header>
  {!lesson?<div class="container fw-overview">
   <section class="fw-invitation"><div><p class="fw-eyebrow">{t('PAPER · PROJECTION · DISCUSSION','紙本・投影・討論')}</p><h2>{t('Make a prediction. Change a condition. Explain why.','先想一想，改一個條件，再講清楚理由。')}</h2><p>{t('Keep your paper worksheet beside you. Take turns at the model, record evidence, compare designs and return to the definition.','保留手上嘅紙本學習單。輪流上台操作模型，全班記錄證據、比較設計，再回到數學定義。')}</p></div><div class="fw-chapter-mark" aria-hidden="true"><span>f</span><small>x → y</small></div></section>
   {groups.map(group=><section class="fw-course-group"><h2>{group.title}</h2><div class="fw-course-grid">{functionWorksheets.filter((item:any)=>group.ids.includes(item.id)).map((item:any)=><article class="fw-course-card"><h3><a href={worksheetUrl(item.id,locale)}>{l(item.title)}</a></h3><p>{l(item.question)}</p><a class="fw-card-link" href={worksheetUrl(item.id,locale)}>{t('Open lesson','開啟課節')} <span aria-hidden="true">↗</span></a></article>)}</div></section>)}
   <section class="fw-chapter-notes"><h2>{t('A lesson with room to think','留有思考空間嘅一課')}</h2><p>{t('A suggested 40-minute lesson: 5 minutes for prediction, 12 for exploration, 8 for reasoning, 12 for paper practice and 3 for an exit task. Each lesson includes teacher questions and a printable observation sheet.','建議一課 40 分鐘：預測 5 分鐘、探究 12 分鐘、說理 8 分鐘、紙本練習 12 分鐘、課末檢核 3 分鐘。每課附教師追問及可列印探究記錄頁。')}</p><p>{t('All eight models work without a sign-in. Classroom notes and backups use the existing learning workspace. Paper responses remain each student’s own evidence.','八組模型均免登入使用；課堂筆記與備份沿用現有研習室工具。紙上作答保留每位學生自己嘅學習證據。')}</p></section>
  </div>:<article class="container fw-lesson fw-direct" data-fw-lesson={lesson.id} data-fw-stage="0">
   <nav class="fw-stages" aria-label={t('Inquiry stages','探究步驟')}>{stages.map((stage,i)=><button type="button" data-fw-stage-button={i} aria-current={i===0?'step':undefined}><span aria-hidden="true">{i+1}</span>{stage}</button>)}</nav>
   <div class="fw-workspace">
    <section class="fw-model" aria-labelledby="fw-model-title">
     <div class="fw-section-head"><h2 id="fw-model-title" data-fw-model-title>{scene.title}</h2><span data-fw-design-label>{t('Paper starting model','紙本起始模型')}</span></div>
     <div class="fw-diagram fw-interactive-board"><svg viewBox="0 0 960 540" role="group" aria-label={t('Drag, connect and build your function model','拖拉、連線及建構函數模型')} data-fw-svg><g data-fw-drawing set:html={scene.svg}/><g data-fw-zones/><g data-fw-handles/><g data-fw-gesture/></svg></div>
     <p class="fw-touch-guide" data-fw-pointer-status aria-live="polite">{t('Drag a handle or select an object, then tap its destination.','拖動手柄，或先選取物件，再點按目的地。')}</p>
     <div class="fw-live-bar"><p data-fw-summary aria-live="polite">{scene.summary}</p><button type="button" data-fw-undo disabled>{t('Undo','復原')}</button><button type="button" data-fw-source>{t('Paper starting model','返回紙本原例')}</button></div>
     <div class="fw-action-tools" data-fw-actions></div>
     <fieldset class="fw-claim-field"><legend>{t('Our claim or choice','我們的主張或選擇')}</legend><div data-fw-claims></div><p class="fw-small">{t('Your construction is also an answer. Explain what you expect before checking.','你砌出來的設計也是答案。檢查前，先講清楚預期結果。')}</p></fieldset>
     <div class="fw-check-row"><button type="button" class="fw-primary" data-fw-check>{t('Check my design','檢查我的設計')}</button><button type="button" data-fw-capture>{t('Keep this work','保留這份作品')}</button><p data-fw-check-status role="status">{t('Give your reason before checking.','先講出理由，再檢查。')}</p></div>
     <section class="fw-diagnosis" data-fw-diagnosis hidden aria-live="polite"><h3 data-fw-diagnosis-title></h3><ul data-fw-diagnosis-lines></ul></section>
     <p class="fw-input-error" data-fw-error role="alert"></p>
     <details class="fw-readings"><summary>{t('Numeric readings','數值記錄')}</summary><div class="fw-table-wrap"><table class="fw-table" data-fw-table><caption>{t('Values in this design','目前設計的數值')}</caption><thead><tr>{scene.headers.map((v:string)=><th scope="col">{v}</th>)}</tr></thead><tbody>{scene.rows.map((row:any[])=><tr>{row.map(v=><td>{v}</td>)}</tr>)}</tbody></table></div></details>
     <details class="fw-access-tools"><summary>{t('Tap and keyboard tools','點選及鍵盤操作')}</summary><p>{t('Tab to an object. Arrow keys move handles; Enter selects a card or places it at a destination.','按 Tab 選取物件；方向鍵移動手柄，Enter 選取卡片或放到目的地。')}</p><p>{t('Select an object','選取物件')}</p><div class="fw-tool-buttons" data-fw-object-tools></div><div class="fw-nudges"><button type="button" data-fw-nudge="-1,0">←</button><button type="button" data-fw-nudge="1,0">→</button><button type="button" data-fw-nudge="0,-1">↑</button><button type="button" data-fw-nudge="0,1">↓</button></div><p>{t('Select a destination','選取目的地')}</p><div class="fw-tool-buttons" data-fw-destination-tools></div><button type="button" data-fw-drop>{t('Place selected object','放置已選物件')}</button></details>
     <details class="fw-works"><summary>{t('Our saved board works','本次課堂作品')}</summary><p class="fw-small">{t('Works stay in this open page. Use the common notebook for consent-based saved notes.','作品留在本次頁面。要保存筆記，可在研習室選擇保存共用筆記。')}</p><ol class="fw-observations" data-fw-observations></ol><button type="button" data-fw-export>{t('Download board works','下載課堂作品')}</button></details>
     <output data-fw-work-state hidden></output>
    </section>
    <aside class="fw-sidebar" aria-label={t('Task and teacher guidance','任務及教師導引')}>
     <section class="fw-task-card"><p class="fw-eyebrow">{t('YOUR TASK','動手任務')}</p><h2>{l(lesson.question)}</h2><p data-fw-task>{scene.task}</p></section>
     <section class="fw-stage-content" data-fw-show-stages="0"><h3>{t('Make a prediction','先留下想法')}</h3><p>{l(lesson.prediction)}</p><p class="fw-small">{t('Write a prediction and reason on paper. Then take turns operating.','先在紙上寫預測及理由，再輪流操作。')}</p><button type="button" data-fw-next>{t('Start exploring →','開始探究 →')}</button></section>
     <section class="fw-stage-content" data-fw-show-stages="1" hidden><h3>{t('Record what changes','記錄改變')}</h3><ol>{lesson.evidence.map((value:any)=><li>{l(value)}</li>)}</ol><button type="button" data-fw-next>{t('Explain our design →','解釋我們的設計 →')}</button></section>
     <section class="fw-stage-content" data-fw-show-stages="2" hidden><h3>{t('Explain your construction','說明設計理由')}</h3><p>{t('An experiment can support a conjecture. A general claim still needs an argument covering its domain.','試驗可以支持猜想；一般主張仍須交代涵蓋定義域的理由。')}</p><div class="fw-hints">{lesson.hints.map((hint:any,i:number)=><details data-fw-hint><summary>{t(`Hint ${i+1}`,`提示 ${i+1}`)}</summary><p><MathText text={l(hint)}/></p></details>)}</div><details class="fw-reasoning" data-fw-answer><summary>{t('Reference reasoning','參考說理')}</summary><p>{l(lesson.explanation)}</p></details><div class="fw-examples">{lesson.workedExamples.map((example:any)=><article><h4>{l(example.prompt)}</h4><MathExpression expression={example.expression} display/><details data-fw-answer><summary>{t('Reveal the steps','逐步核對解法')}</summary><ol>{example.steps.map((step:any)=><li>{l(step)}</li>)}</ol></details></article>)}</div><button type="button" data-fw-next>{t('Try a new case →','用喺新例子 →')}</button></section>
     <section class="fw-stage-content" data-fw-show-stages="3" hidden><h3>{t('Transfer','遷移')}</h3><p>{l(lesson.transfer)}</p><article class="fw-exit"><p class="fw-eyebrow">{t('EXIT TASK · 3 MINUTES','課末檢核・3 分鐘')}</p><h4>{l(lesson.exit.prompt)}</h4><p>{t('Write an answer and reason on paper.','在紙上寫答案及理由。')}</p><details data-fw-answer><summary>{t('Teacher reference and reasoning checklist','教師參考與說理清單')}</summary><p>{l(lesson.exit.answer)}</p><ul>{lesson.exit.rubric.map((value:any)=><li>{l(value)}</li>)}</ul></details></article></section>
     <div class="fw-step-footer"><button type="button" data-fw-prev disabled>{t('← Back','← 上一步')}</button><p data-fw-stage-status role="status">{stages[0]}</p><button type="button" data-fw-advance>{t('Next →','下一步 →')}</button></div>
     <details class="fw-teacher-presets"><summary>{t('Teacher model sets','教師題組')}</summary><div data-fw-choices></div></details>
     <details class="fw-teacher" id="teacher"><summary>{t('Teacher preparation and paper cross-reference','教師備課與紙本對照')}</summary><p>{lesson.sourceSection} · {lesson.sourceFilename}</p><p>{l(lesson.teacher.timing)}</p>{[['prompts',t('Questions','課堂追問')],['anticipated',t('Expected responses','預期回應')],['pitfalls',t('Confusions','留意混淆')],['board',t('Board plan','板書重點')]].map(([key,title])=><section><h3>{title}</h3><ul>{lesson.teacher[key].map((value:any)=><li>{l(value)}</li>)}</ul></section>)}</details>
    </aside>
   </div>
   <nav class="fw-related" aria-label={t('Revisit the idea','補充重溫')}><span>{t('Revisit:','延伸重溫：')}</span>{lesson.relatedLessons.map((id:string)=><a href={`${zh?'/zh':''}/teaching/senior-math/lessons/${id}/`}>{relatedNames[id]||id}</a>)}</nav>
   <nav class="fw-lesson-navigation" aria-label={t('Previous and next lessons','前後課節')}>{previousLesson?<a href={worksheetUrl(previousLesson.id,locale)}>← {l(previousLesson.title)}</a>:<span/>}{nextLesson&&<a href={worksheetUrl(nextLesson.id,locale)}>{l(nextLesson.title)} →</a>}</nav>
   <noscript><p>{t('Interactive controls and stage navigation need JavaScript. The printable observation sheet and teacher reference below remain readable.','操作及分步導航需要 JavaScript；下方探究記錄頁及教師參考仍可閱讀。')}</p><style>{`@media screen{.function-chapter .fw-print{display:block!important}}.function-chapter .fw-model,.function-chapter .fw-stages,.function-chapter .fw-step-footer{display:none!important}`}</style></noscript>
  </article>}
 </div>
 {lesson&&<>
 <section class="fw-print" data-fw-print-student hidden><header><p>{l(chapterTitle)}</p><h2 class="fw-print-title">{l(lesson.title)}</h2><p>{t('Class ______ Name __________________ Date __________','班別 ______ 姓名 __________________ 日期 __________')}</p></header><h2>{l(lesson.question)}</h2><div data-fw-print-work hidden/><h3>{t('My prediction and reason','我的預測與理由')}</h3><p>{l(lesson.prediction)}</p><div class="fw-writing-lines"/><h3>{t('Evidence and observations','證據與觀察')}</h3>{lesson.evidence.map((value:any)=><div><p>{l(value)}</p><div class="fw-writing-lines"/></div>)}<h3>{t('Explain or give a counterexample','解釋或提出反例')}</h3><div class="fw-writing-lines"/><h3>{t('Transfer','遷移')}</h3><p>{l(lesson.transfer)}</p><div class="fw-writing-lines"/><h3>{t('Exit task','課末檢核')}</h3><p>{l(lesson.exit.prompt)}</p><div class="fw-writing-lines"/></section>
 <section class="fw-print" data-fw-print-teacher hidden><header><p>{l(chapterTitle)} · {t('Teacher reference','教師參考')}</p><h2 class="fw-print-title">{l(lesson.title)}</h2><p>{lesson.sourceSection} · {lesson.sourceFilename}</p></header><p>{l(lesson.teacher.timing)}</p><h2>{l(lesson.question)}</h2><p>{l(lesson.prediction)}</p><h3>{t('Evidence tasks','證據任務')}</h3><ol>{lesson.evidence.map((value:any)=><li>{l(value)}</li>)}</ol><h3>{t('Reference reasoning','參考說理')}</h3><p>{l(lesson.explanation)}</p>{lesson.workedExamples.map((example:any)=><article><h3>{l(example.prompt)}</h3><MathExpression expression={example.expression} display/><ol>{example.steps.map((value:any)=><li>{l(value)}</li>)}</ol></article>)}<h3>{t('Transfer and exit task','遷移與課末檢核')}</h3><p>{l(lesson.transfer)}</p><p>{l(lesson.exit.prompt)}</p><p>{l(lesson.exit.answer)}</p><ul>{lesson.exit.rubric.map((value:any)=><li>{l(value)}</li>)}</ul>{[['prompts',t('Questions','追問')],['anticipated',t('Expected responses','預期回應')],['pitfalls',t('Confusions','混淆')],['board',t('Board plan','板書')]].map(([key,title])=><section><h3>{title}</h3><ul>{lesson.teacher[key].map((value:any)=><li>{l(value)}</li>)}</ul></section>)}</section>
 </>}
</div>
<script>
 import {initializeFunctionWorksheets} from '../scripts/function-worksheet-ui';
 document.querySelectorAll<HTMLElement>('[data-function-worksheet]').forEach(initializeFunctionWorksheets);
</script>
