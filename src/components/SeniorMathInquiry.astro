---
import { inquiryControls, inquiryScene, normalizeInquiryType } from '../lib/senior-math-inquiry.mjs';
import {skillInquiryControls,skillInquiryScene} from '../lib/skill-inquiry.mjs';
import MathExpression from './MathExpression.astro';
interface Props { inquiry:any; locale?:'en'|'zh-Hant'; lessonId:string }
const {inquiry,locale='en',lessonId}=Astro.props;
const zh=locale==='zh-Hant',label=(pair:any)=>pair?.[zh?'zh':'en']||'';
const reading=inquiry.type==='reading',skill=inquiry.type==='skill',modelId=inquiry.skillId||lessonId;
const type=reading?'reading':skill?'skill':normalizeInquiryType(inquiry.type,lessonId),controls=reading?[]:skill?skillInquiryControls(modelId):inquiryControls(type,lessonId);
const scene:any=reading?null:skill?skillInquiryScene(modelId,Object.fromEntries(controls.map((c:any)=>[c.key,Number(c.value)]))):inquiryScene(type,Number(controls[0].value),Number(controls[1].value),lessonId);
---
<section class="jae-graph-lab senior-inquiry" data-graph-section={!reading} data-senior-lab={reading?undefined:type} data-senior-reading={reading?true:undefined} data-model-id={modelId} data-lesson-id={lessonId}>
  <div class="jae-lab-head"><p class="jae-eyebrow">{reading?(zh?'預測 → 比較 → 解釋 → 遷移':'PREDICT → COMPARE → EXPLAIN → TRANSFER'):(zh?'預測 → 操作 → 解釋 → 遷移':'PREDICT → EXPLORE → EXPLAIN → TRANSFER')}</p><h3>{reading?(zh?'比較實際題目及其條件。':'Compare the actual tasks and their conditions.'):(zh?'先留下預測，再探索關係。':'Make a prediction, then explore the relationship.')}</h3><p>{zh?'課節思考：':'Lesson question: '}{label(inquiry.prediction)}</p>{!reading&&<p>{zh?'模型實驗：先預測調整下列參數會改變哪個結果，再以顯示的數值檢查，並與課節問題比較。':'Model exploration: predict which displayed result changes with the parameters, check the values, and compare the observation with the lesson question.'}</p>}</div>
  {inquiry.scopeNote&&<p class="senior-model-scope">{label(inquiry.scopeNote)}</p>}
  {reading?<div class="senior-reading-tasks">{inquiry.readingTasks.map((q:any)=><article><h4>{label(q.prompt)}</h4>{q.expression&&<MathExpression expression={q.expression} display/>}{q.conditions?.length>0&&<ul>{q.conditions.map((c:any)=><li>{label(c)}</li>)}</ul>}{q.promptSvg&&<div class="senior-prompt-svg" set:html={q.promptSvg}/>}</article>)}</div>:<>
  <div class="jae-lab-layout"><div class="jae-plot"><svg viewBox="0 0 640 360" role="img" aria-label={zh?'數學探究示意圖':'Mathematical inquiry diagram'} data-inquiry-plot><title>{label(scene.summary)}</title>{scene.paths.map((p:any)=><path d={p.d} fill="none" stroke={p.color} stroke-width={p.width||2.5}/>)}{scene.circles.map((p:any)=><circle cx={p.x} cy={p.y} r={p.r} fill="none" stroke={p.color} stroke-width="2"/>)}{scene.labels.map((p:any)=><text x={p.x} y={p.y} font-size={p.fontSize||(String(p.text).length>40?12:19)} fill="#314937">{p.text}</text>)}</svg><p data-inquiry-summary aria-live="polite">{label(scene.summary)}</p></div>
  <div class="jae-graph-controls" data-interactive-only hidden>{controls.map((control:any)=><label>{label(control.label)}<output data-inquiry-value={control.key}>{control.value}</output><input type="range" data-inquiry-param={control.key} min={control.min} max={control.max} step={control.step} value={control.value}/></label>)}<button type="button" data-inquiry-reset>{zh?'重設操作':'Reset exploration'}</button></div></div>
  <div class="senior-table-wrap" data-inquiry-table>{scene.table&&<table class="senior-table"><caption>{zh?'圖像的數值資料，可列印':'Numerical data for the diagram; printable'}</caption><thead><tr>{scene.table.headers.map((h:any)=><th>{label(h)}</th>)}</tr></thead><tbody>{scene.table.rows.map((row:any)=><tr>{row.map((v:any)=><td>{v}</td>)}</tr>)}</tbody></table>}</div>
  </>}
  <div class="senior-inquiry-reasoning">{(type==='probability'||modelId==='probability-models')&&<div><button type="button" data-inquiry-simulate data-interactive-only hidden>{zh?'模擬 200 次':'Simulate 200 trials'}</button><p data-inquiry-simulation role="status">{zh?'比較有限次模擬與上方精確概率；模擬頻率可能有偏差。':'Compare a finite simulation with the exact probabilities above; simulated frequencies can differ.'}</p><div data-inquiry-simulation-table></div></div>}<p><strong>{zh?'解釋：':'Explain: '}</strong>{label(inquiry.explanation)}</p><p><strong>{zh?'遷移：':'Transfer: '}</strong>{label(inquiry.transfer)}</p><label data-interactive-only hidden>{zh?'我的預測、操作與理由':'My prediction, exploration and explanation'}<textarea rows="3" maxlength="6000" data-inquiry-note></textarea></label></div>
</section>
