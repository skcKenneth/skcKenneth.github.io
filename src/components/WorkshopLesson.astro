---
import {modelCardFields,rubric} from "../data/workshop-lessons";
import MathExpression from "./MathExpression.astro";
import type {WorkshopLesson,WorkshopLocale} from "../types/workshop";
import rawNotes from "../data/generated/teaching-lecture-catalogue.json";
import "../styles/workshop.css";
const {lesson,locale="en"}=Astro.props as {lesson:WorkshopLesson;locale:WorkshopLocale};
const zh=locale==="zh-Hant";const base=`${zh?"/zh":""}/teaching/modeling-workshop`;const assets=`/resources/modeling-workshop/${lesson.slug}`;
const notes=[...lesson.notes,"writing-01","writing-02","writing-03","writing-04","writing-05"].map(id=>rawNotes.units.find(u=>u.id===id)!);
---
<div class="workshop ws-lesson" data-workshop-lesson data-locale={locale} data-lesson={JSON.stringify(lesson)}>
<header class="container ws-lesson-head"><a class="ws-small" href={`${base}/`}>← {zh?"學習地圖":"Learning map"}</a><p class="eyebrow">{zh?"數學建模學習工坊":"MATHEMATICAL MODELING WORKSHOP"} / {lesson.number}</p><h1>{lesson.title[locale]}</h1><p class="lead">{lesson.question[locale]}</p><div class="ws-meta-row"><span>{zh?"約 150 分鐘":"About 150 minutes"}</span><span>{zh?"合成教學實驗":"Synthetic teaching experiment"}</span><span>v{lesson.version}</span><span data-save-status role="status">{zh?"正在讀取本機草稿…":"Reading local draft…"}</span></div><details class="ws-orientation"><summary>{zh?"學習目標與先備條件":"Learning objectives & prerequisites"}</summary><p>{lesson.prerequisites[locale]}</p><ul>{lesson.objectives.map(o=><li>{o[locale]}</li>)}</ul></details></header>
<nav class="ws-mobile-tabs" aria-label={zh?"工作台面板":"Workbench panels"}><button type="button" data-tab-button="task" aria-pressed="true">{zh?"任務":"Task"}</button><button type="button" data-tab-button="code" aria-pressed="false">Python</button><button type="button" data-tab-button="results" aria-pressed="false">{zh?"結果與紀錄":"Results & record"}</button></nav>
<div class="container ws-workbench">
<aside class="ws-step-nav"><p class="eyebrow">{zh?"你的建模過程":"YOUR MODELING PROCESS"}</p><ol>{lesson.steps.map((s,i)=><li><button type="button" data-step-button={i} aria-current={i===0?"step":undefined}><span>{String(i+1).padStart(2,"0")}</span>{s.title[locale]}<small data-step-mark={s.id}></small></button></li>)}</ol><progress max={8} value={0} data-completion aria-label={zh?"自行標記的完成進度":"Self-marked completion progress"}></progress><p class="ws-small" data-completion-label>{zh?"0 / 8 步驟":"0 / 8 steps"}</p><p class="ws-small">{zh?"可自由返回修訂，完成標記不代表評分。":"Return and revise freely. Completion marks are not grades."}</p></aside>
<section class="ws-task-panel" aria-label={zh?"當前學習任務":"Current learning task"}>
{lesson.steps.map((s,i)=><section class="ws-step" data-step={i}><p class="eyebrow">{String(i+1).padStart(2,"0")} / 08 · {s.minutes} {zh?"分鐘":"MIN"}</p><h2 tabindex="-1">{s.title[locale]}</h2><p class="ws-explanation">{s.body[locale]}</p>{i===3&&<div class="ws-equation"><MathExpression expression={lesson.equation} display/></div>}<div class="ws-task-prompt"><span class="ws-badge">{zh?"輪到你":"YOUR TURN"}</span><p>{s.task[locale]}</p></div><label class="ws-field"><span>{zh?"你的推理與回答":"Your reasoning & response"}</span><textarea rows="5" data-answer={s.id} placeholder={zh?"保留推理過程，即使之後需要修訂。":"Keep your reasoning, even if you revise it later."}></textarea></label><div class="ws-step-actions"><button type="button" class="button secondary" data-complete={s.id}>{zh?"標記本步完成":"Mark step complete"}</button>{i<7&&<button type="button" class="button" data-next={i+1}>{zh?"下一步":"Next step"} →</button>}</div></section>)}
<div class="ws-hints"><h3>{zh?"需要一點提示？":"Need a little guidance?"}</h3>{lesson.hints.map((h,i)=><details><summary>{i+1}. {zh?["概念提示","數學／算法提示","參考實作導引"][i]:["Concept hint","Mathematical / algorithm hint","Reference implementation guide"][i]}</summary><p>{h[locale]}</p>{i===2&&<><p class="ws-small">{zh?"先比較推理，再選擇是否套用。套用前會另存你目前的程式。":"Compare the reasoning before applying it. Your current code is backed up before replacement."}</p><pre data-reference-code tabindex="0"></pre><button class="button secondary" type="button" data-use-reference>{zh?"套用參考程式":"Use reference code"}</button><button class="button secondary" type="button" data-restore-code disabled>{zh?"還原我的程式":"Restore my code"}</button></>}</details>)}</div>
<details class="ws-protocol"><summary>{zh?"實驗協定：比較、失效與延伸":"Experiment protocol: comparison, failure & extension"}</summary><h3>{zh?"指定比較":"Required comparison"}</h3><p>{lesson.comparison[locale]}</p><h3>{zh?"失效實驗":"Failure experiment"}</h3><p>{lesson.failure[locale]}</p><h3>{zh?"研究延伸":"Research extension"}</h3><p>{lesson.extension[locale]}</p></details>
</section>
<section class="ws-code-panel" aria-label={zh?"Python 程式工作台":"Python workbench"}>
<div class="ws-panel-title"><p class="eyebrow">PYTHON WORKBENCH</p><h2>{zh?"先預測，再執行。":"Predict. Then run."}</h2></div><label class="ws-field"><span>{zh?"執行前預測（先寫下預期變化）":"Prediction before execution (write what you expect)"}</span><textarea rows="3" data-prediction></textarea></label>
<details open class="ws-parameters"><summary>{zh?"實驗參數與種子":"Parameters & random seed"}</summary><div class="ws-parameter-grid">{lesson.parameters.map(p=><label class="ws-field"><span>{p.label[locale]}</span>{p.options?<select data-param={p.key}>{p.options.map(o=><option value={o.value} selected={o.value===p.value}>{o.label[locale]}</option>)}</select>:<input type="number" data-param={p.key} value={p.value} min={p.min} max={p.max} step={p.step}/>}</label>)}<label class="ws-field"><span>{zh?"隨機種子":"Random seed"}</span><input type="number" data-seed value={2026} min={0} max={2147483647} step={1}/></label></div></details>
<div class="ws-editor-toolbar"><button type="button" class="button secondary" data-enable-editor>{zh?"開啟程式編輯器":"Open code editor"}</button><button type="button" class="button secondary" data-reset-code>{zh?"重設為練習起始碼":"Reset to starter code"}</button></div><label class="ws-field ws-plain-code"><span>{zh?"你的 Python 程式":"Your Python code"}</span><textarea spellcheck="false" rows="12" data-code aria-label={zh?"你的 Python 程式":"Your Python code"}></textarea></label><div data-editor class="ws-editor" hidden></div>
<p class="ws-small">{zh?"可直接修改以上程式，或開啟語法標示編輯器。起始碼的待完成部分會令相關檢查失敗；請依推導修正 student_model。":"Edit directly above or open the syntax-highlighting editor. The starter's unfinished student_model should fail relevant checks; use your derivation to complete it."}</p>
<div class="ws-run-actions"><button class="button" type="button" data-init>{zh?"啟動 Python":"Start Python"}</button><button class="button" type="button" data-run disabled>{zh?"執行完整實驗":"Run full experiment"}</button><button class="button secondary" type="button" data-stop disabled>{zh?"停止運算":"Stop"}</button></div><p role="status" data-runtime-status>{zh?"按啟動才下載運算環境；每次實驗使用獨立命名空間，最多 30 秒。":"The runtime downloads only when started. Each experiment uses a fresh namespace and a 30-second limit."}</p><pre class="ws-console" data-console tabindex="0" aria-label={zh?"Python 輸出與錯誤":"Python output and errors"}></pre>
<p class="ws-small">{zh?"無法載入？仍可下載獨立 notebook，在安裝 NumPy、SciPy、Matplotlib 的 Python 環境執行。":"Unable to load? Download the standalone notebook and run it in Python with NumPy, SciPy and Matplotlib."} <a href={`${assets}/reference.ipynb`} download>{zh?"參考 notebook":"Reference notebook"}</a></p>
</section>
<aside class="ws-results-panel"><div class="ws-panel-title"><p class="eyebrow">{zh?"模型與證據":"MODEL & EVIDENCE"}</p><h2>{zh?"讓推理留下紀錄。":"Make your reasoning visible."}</h2></div>
<details class="ws-model-card"><summary>{zh?"我的模型卡":"My model card"}</summary>{modelCardFields.map(f=><label class="ws-field"><span>{f.label[locale]}</span><textarea rows="2" data-card={f.key}></textarea></label>)}</details>
<section class="ws-live-result"><h3>{zh?"我的實驗結果":"My experiment result"}</h3><p data-result-status role="status">{zh?"尚未執行。下方圖片是預先生成的參照結果。":"Not run. The image below is a precomputed reference."}</p><button type="button" class="button secondary" data-compare disabled>{zh?"並排比較基準與我的運行":"Compare baseline and my run side by side"}</button><div data-results></div><div class="ws-animation" data-animation hidden><h4>{zh?"逐輪網格（你的規則）":"Grid by sweep (your rules)"}</h4><canvas width="288" height="288" aria-label={zh?"代理人網格動畫":"Agent grid animation"}></canvas><label>{zh?"輪次":"Sweep"} <output data-frame-number>0</output><input type="range" min="0" value="0" step="1" data-frame/></label><button type="button" class="button secondary" data-play>{zh?"播放／暫停":"Play / pause"}</button><p class="ws-small">{zh?"米白：空位；深綠：類型 1；橙：類型 2。":"Cream: vacancy; green: type 1; orange: type 2."}</p></div></section>
<details class="ws-baseline" open><summary>{zh?"預先生成的參照結果（非你的運行）":"Precomputed reference (not your run)"}</summary><img src={`${assets}/figure-1.png`} width="792" height="456" alt={zh?`${lesson.title[locale]}：參照實驗圖`:`${lesson.title[locale]}: reference experiment figure`} loading="lazy"/><p>{lesson.interpretation[locale]}</p><p class="ws-small">{zh?"預設參數、種子 2026，與你的修改情境分開標示。":"Default parameters, seed 2026; displayed separately from your modified experiment."}</p><a href={`${assets}/baseline.csv`} download>{zh?"下載參照 CSV":"Download reference CSV"}</a></details>
<label class="ws-field"><span>{zh?"執行後反思、證據與限制":"Post-run reflection, evidence & limitations"}</span><textarea rows="4" data-reflection></textarea></label>
<details class="ws-rubric"><summary>{zh?"研究判斷：自評準則":"Research judgment: self-review rubric"}</summary><ul>{rubric.map(r=><li>{r[locale]}</li>)}</ul><p class="ws-small">{zh?"文字回答不會用關鍵字自動評分；程式檢查也不能代替研究判斷。":"Written responses are not graded by keywords. Code checks do not replace research judgment."}</p></details>
<section class="ws-exports"><h3>{zh?"帶走你的成果":"Take your work with you"}</h3><div class="ws-export-buttons">{[["json",zh?"草稿 JSON":"Draft JSON"],["notebook","Notebook"],["python","Python"],["report",zh?"研究報告":"Report"],["csv",zh?"我的 CSV":"My CSV"],["figures",zh?"我的圖像":"My figures"]].map(([key,label])=><button type="button" class="button secondary" data-export={key}>{label}</button>)}</div><label class="ws-field"><span>{zh?"匯入此課草稿（不會執行程式）":"Import this lesson's draft (never executes code)"}</span><input type="file" accept="application/json,.json" data-import/></label><p data-import-status role="status"></p><button type="button" class="ws-text-button" data-reset-lesson>{zh?"清除此課進度":"Reset this lesson"}</button><p class="ws-small">{zh?"本機保存不會跨裝置同步，請定期匯出 JSON。":"Local saving does not sync across devices. Export JSON regularly."}</p></section>
</aside></div>
<section class="container ws-section ws-references"><h2>{zh?"把這一課連回你的書架。":"Connect this lesson to your bookshelf."}</h2><div class="ws-reference-columns"><div><h3>{zh?"課文與寫作 Notes":"Lecture & writing Notes"}</h3><ul>{notes.map(n=><li><a href={`${zh?"/zh":""}/teaching/mathematical-modeling-lecture-programme/${n.id}/`}>{n.title[locale]}</a></li>)}</ul></div><div><h3>{zh?"書籍章節（PDF 頁與印刷頁分列）":"Book chapters (PDF and print pages separated)"}</h3><ul>{lesson.references.map(r=><li>{r.book}<br/>{r.chapter}<br/><span class="ws-small">PDF {r.pdfPages} · {zh?"印刷頁":"Print"} {r.printedPages}</span></li>)}</ul><a href={`${base}/sources/`}>{zh?"完整來源對照":"Full source map"}</a></div></div></section>
<dialog class="ws-compare-dialog" data-confirm-dialog aria-labelledby="ws-confirm-title"><h2 id="ws-confirm-title">{zh?"確認草稿變更":"Confirm draft change"}</h2><p data-confirm-message></p><form method="dialog"><button class="button secondary" value="cancel" autofocus>{zh?"取消":"Cancel"}</button> <button class="button" value="confirm">{zh?"下載備份並繼續":"Download backup and continue"}</button></form></dialog>
<dialog class="ws-compare-dialog" data-compare-dialog><form method="dialog"><button class="button secondary">{zh?"關閉比較":"Close comparison"}</button></form><h2>{zh?"基準與我的運行":"Baseline and my run"}</h2><p>{zh?"基準由指定合成資料生成；右方只展示你最後完成的運行。":"The baseline uses the specified synthetic data; the right column shows only your last completed run."}</p><div class="ws-compare-grid" data-comparison></div></dialog>
<noscript><div class="container"><p>{zh?"閱讀課文及下載參照程式無需 JavaScript；互動、保存與瀏覽器 Python 需要啟用 JavaScript。":"Reading and reference downloads work without JavaScript. Interactions, saving and browser Python require JavaScript."}</p></div></noscript>
</div>
<script>
 import {initializeWorkshopLesson} from "../scripts/workshop-client";
 document.querySelectorAll<HTMLElement>("[data-workshop-lesson]").forEach(initializeWorkshopLesson);
</script>
