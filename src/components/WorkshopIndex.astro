---
import {lessons,pathways,bi} from "../data/workshop-lessons";
import rawNotes from "../data/generated/teaching-lecture-catalogue.json";
import type {WorkshopLocale} from "../types/workshop";
import "../styles/workshop.css";
const {locale="en"}=Astro.props as {locale?:WorkshopLocale};const zh=locale==="zh-Hant";const base=`${zh?"/zh":""}/teaching/modeling-workshop`;
const needs=[{question:bi("Can you explain a derivative's units?","你能解釋導數的單位嗎？"),note:"supplementary-05"},{question:bi("Can you solve a small linear system?","你能解小型線性系統嗎？"),note:"supplementary-09"},{question:bi("Can you distinguish mean and uncertainty?","你能分辨平均值與不確定性嗎？"),note:"supplementary-08"},{question:bi("Can you write a Python function over an array?","你能編寫處理陣列的 Python 函式嗎？"),note:"python"}];
---
<div class="workshop ws-index" data-workshop-index data-locale={locale}>
<header class="ws-hero container"><div><p class="eyebrow">{zh?"數學建模學習工坊 / 大學與研究入門":"MATHEMATICAL MODELING WORKSHOP / UNIVERSITY & RESEARCH"}</p><h1>{zh?<>由一個問題，<br/>走到可重現的研究。</>:<>From a question<br/>to reproducible research.</>}</h1><p class="lead">{zh?"每一條方程，都有假設。每一次運算，都需要證據。親手完成六個模型，學會解釋它們何時值得相信。":"Every equation makes assumptions. Every computation needs evidence. Build six models and learn to explain when they deserve your trust."}</p><div class="actions"><a class="button" href={`${base}/${lessons[0].slug}/`}>{zh?"從混合槽開始":"Start with a mixing tank"} →</a><a class="button secondary" href="#learning-map">{zh?"查看學習地圖":"Explore the learning map"}</a></div><p class="ws-meta">{zh?"6 個完整單元 · 每課約 2–3 小時 · 繁中 / EN · 免登入":"6 complete units · 2–3 hours each · 繁中 / EN · No sign-in"}</p><p data-resume aria-live="polite"></p></div>
<div class="ws-hero-diagram" aria-label={zh?"建模與驗證循環":"Modeling and validation cycle"}>
 <div class="ws-orbit"><span>{zh?"現象":"Phenomenon"}</span><span>{zh?"假設":"Assumptions"}</span><span>{zh?"模型":"Model"}</span><span>Python</span><span>{zh?"證據":"Evidence"}</span><span>{zh?"修訂":"Revision"}</span></div><div class="ws-hero-center"><span>01 — 06</span><strong>{zh?"不只求解。\n也要問為甚麼。":"Solve it.\nThen question it."}</strong><small>{zh?"你的問題，貫穿整個過程。":"Your question connects every step."}</small></div>
</div></header>
<section class="ws-band"><div class="container ws-principles"><article><span>01 /</span><h2>{zh?"先提出問題":"Question first"}</h2><p>{zh?"寫清楚研究目標、單位與假設，再選擇算法。":"State the objective, units and assumptions before choosing an algorithm."}</p></article><article><span>02 /</span><h2>{zh?"親手建立證據":"Build evidence"}</h2><p>{zh?"在瀏覽器編寫 Python，對照解析解、基準與失效案例。":"Write Python in your browser; compare exact solutions, baselines and failures."}</p></article><article><span>03 /</span><h2>{zh?"帶走完整成果":"Take your work with you"}</h2><p>{zh?"本機保存，匯出 notebook、資料、圖表及你的研究紀錄。":"Save locally and export notebooks, data, figures and your research record."}</p></article></div></section>
<section class="container ws-section" id="learning-map"><p class="eyebrow">{zh?"核心路線":"THE CORE PATH"}</p><h2>{zh?"六個問題，六種建模能力。":"Six questions. Six ways to model."}</h2><div class="ws-lesson-grid">{lessons.map(l=><article class="ws-lesson-card"><span class="ws-number">{l.number}</span><p class="ws-meta">{zh?"完整工坊 · 150 分鐘":"Complete workshop · 150 minutes"}</p><h3><a href={`${base}/${l.slug}/`}>{l.title[locale]}</a></h3><p>{l.question[locale]}</p><p class="ws-small">{l.summary[locale]}</p><a class="ws-start" href={`${base}/${l.slug}/`}>{zh?"開始建模":"Start modeling"} <span aria-hidden="true">↗</span></a><p class="ws-small" data-progress-for={l.id}></p></article>)}</div></section>
<section class="container ws-section ws-diagnostic" id="prerequisites"><div><p class="eyebrow">{zh?"先備補給站":"A QUICK READINESS CHECK"}</p><h2>{zh?"按需要補充，隨時可以開始。":"Refresh what you need. Start when you want."}</h2><p>{zh?"標記你想重溫的能力，下面會指出對應 Notes。這不是入學測驗，不會鎖住任何課程。":"Mark the skills you want to refresh to find the matching Notes. This is a reading guide; it never locks a lesson."}</p></div><form>{needs.map(n=><label class="ws-diagnostic-item"><input type="checkbox" data-refresh={n.note}/><span>{n.question[locale]}<small>{zh?"勾選：我想重溫":"Check to refresh"}</small></span></label>)}<div data-diagnostic-results aria-live="polite"></div></form></section>
<section class="container ws-section"><p class="eyebrow">{zh?"完成核心之後":"BEYOND THE CORE"}</p><h2>{zh?"把方法帶到你的研究問題。":"Carry the methods into your own question."}</h2><p>{zh?"以下提供閱讀與研究藍圖，尚未提供完整互動工坊。":"These branches offer reading and research roadmaps; complete interactive workshops are not yet available."}</p><div class="ws-pathways">{pathways.map(p=><article><span class="ws-badge">{zh?"進階閱讀路線":"Reading roadmap"}</span><h3>{p.title[locale]}</h3><p>{p.question[locale]}</p><p class="ws-small"><strong>{zh?"先備：":"Prerequisites: "}</strong>{p.needs[locale]}</p><p class="ws-small">{p.reading}</p></article>)}</div></section>
<section class="container ws-section"><h2>{zh?"27 個 Notes，成為隨身工具箱。":"27 Notes units, one companion library."}</h2><p>{zh?"12 個主課、10 個數學補充課與5個寫作單元，均已對應到六個工坊。書籍提供章節來源；教學文字、例題與程式為原創。":"Twelve core lectures, ten mathematical refreshers and five writing units are mapped to the workshops. Books supply chapter references; teaching text, examples and code are original."}</p><div class="actions"><a class="button secondary" href={`${zh?"/zh":""}/teaching/mathematical-modeling-lecture-programme/`}>{zh?"閱讀 Notes":"Read the Notes"}</a><a class="button secondary" href={`${base}/sources/`}>{zh?"20 份書籍與 Notes 對照":"20 books & Notes source map"}</a></div><p class="ws-small">{zh?"進度只保存在目前瀏覽器。清除網站資料會移除紀錄；請定期匯出 JSON。首次執行 Python 需網絡載入科學運算環境。":"Progress stays in this browser. Clearing site data removes it; export JSON regularly. The first Python startup needs a network connection to load the scientific runtime."}</p></section>
<script is:inline id="workshop-index-notes" type="application/json" set:html={JSON.stringify(rawNotes.units.map(n=>({id:n.id,title:n.title}))).replace(/</g,"\\u003c")}/>
</div>
<script>
 import {initializeWorkshopIndex} from "../scripts/workshop-client";
 document.querySelectorAll<HTMLElement>("[data-workshop-index]").forEach(initializeWorkshopIndex);
</script>
