---
import JaeMathStudio from './JaeMathStudio.astro';
import MathExpression from './MathExpression.astro';
import SeniorMathExamMap from './SeniorMathExamMap.astro';
import {books,chapters,coreLessons,lessons,papers,questions,schoolRoutes,lessonById,questionById,label,base,lessonUrl,questionUrl,paperUrl,questionTopic,syllabusSources,sourceById,relatedLessonIds,examinationCodesForQuestion,schoolPathIds} from '../data/senior-math/catalog.mjs';
import { pageTitle } from '../lib/senior-math-title.mjs';
import '../styles/senior-math.css';
interface Props {page:any;locale?:'en'|'zh-Hant'}
const {page,locale='en'}=Astro.props,zh=locale==='zh-Hant',t=(en:string,ch:string)=>zh?ch:en,l=(pair:any)=>label(pair,locale),root=base(locale);
const item=page.type==='lesson'?lessonById.get(page.id):page.type==='question'?questionById.get(page.id):page.type==='book'?books.find((b:any)=>b.id===page.id):page.type==='chapter'?chapters.find((c:any)=>c.id===page.id):page.type==='school'?schoolRoutes.find((r:any)=>r.id===page.id):page.type==='paper'?papers.find((p:any)=>p.id===page.id):null;
const lessonItem=page.type==='lesson'?item:page.type==='question'?questionTopic(item):page.type==='paper'?{id:item.id,title:{en:`${item.year} ${item.code}`,zh:`${item.year} ${item.code}`},summary:item.source,objectives:[],concepts:[],misconceptions:[],questions:item.questions}:null;
const topic=lessonItem?{...lessonItem,questions:lessonItem.questions.map((q:any)=>({...q,permalink:questionUrl(q.id,locale),relatedLessons:relatedLessonIds(q).map(id=>({title:lessonById.get(id).title,url:lessonUrl(id,locale)})),officialUrl:q.source?.paperId?papers.find(p=>p.id===q.source.paperId)?.url:undefined,...(q.source?.type==='official'?{rubric:[{en:'Teaching assessment checklist, independently authored. Use the original paper for official marks.',zh:'以下為自編教學評核清單；官方分值以原卷為準。'},...q.steps.map((step:any)=>({...step.body,math:step.math}))]}:{})}))}:null;
const lessonSource=sourceById.get(lessonItem?.source?.documentId);
const lessonSourceUrl=lessonSource&&'url' in lessonSource?lessonSource.url:undefined;
const lessonSelection=page.type==='book'?coreLessons.filter((c:any)=>c.bookId===item.id):page.type==='chapter'?coreLessons.filter((c:any)=>c.chapterId===item.id):lessons;
const formatLevel=(level:string)=>({foundation:t('Foundation','基礎'),standard:t('Standard','鞏固'),transfer:t('Transfer','遷移')}[level]||level);
const diagnosticIds=['c1-1-1','c1-2-3','c1-3-1','c1-4-1','c1-5-1','c2-6-1'];
const diagnosticTopics=diagnosticIds.map(id=>lessonById.get(id)).filter(Boolean).map((lesson:any)=>({...lesson,concepts:[],inquiry:undefined,questions:[{...lesson.questions.find((q:any)=>q.kind!=='example'),permalink:questionUrl(lesson.questions.find((q:any)=>q.kind!=='example').id,locale)}]}));
const questionLessons=(q:any)=>relatedLessonIds(q);
const bankBooks=(q:any)=>[...new Set([q.bookId,...questionLessons(q).map(id=>lessonById.get(id)?.bookId)].filter(Boolean))].join(' ');
const bankExams=(q:any)=>examinationCodesForQuestion(q).join(' ');
const bankSchools=(q:any)=>[...new Set(questionLessons(q).flatMap(schoolPathIds))].join(' ');
const brief=t('Read the idea, work independently, then explain what changed.','先理解概念，獨立嘗試，再解釋想法如何改變。');
---
<div class="senior-math" data-senior-page={page.type}>
  <header class="senior-hero container"><a class="senior-back" href={page.type==='home'?(zh?'/zh/teaching/':'/teaching/'):root}>← {page.type==='home'?t('Teaching resources','教學資源'):t('Senior Mathematics Studio','高中數學研習室')}</a><p class="eyebrow">{t('LEARN · EXPLAIN · REVISE','學習・解釋・訂正')}</p><h1>{pageTitle(page,locale)}</h1><p class="senior-lead">{brief}</p><nav class="senior-nav" aria-label={t('Mathematics resources','數學資源')}><a href={root}>{t('Course overview','課程總覽')}</a><a href={root+'question-bank/'}>{t('Question bank','題庫')}</a><a href={root+'papers/'}>{t('Past papers','舊卷')}</a><a href={root+'paths/remedial/'}>{t('Foundations','補底')}</a><a href={root+'paths/exam/'}>{t('Exam skills','備試')}</a><a href={root+'teacher/'}>{t('Teacher resources','教師資源')}</a></nav></header>

  {page.type==='home' && <div class="container senior-content">
    <section class="senior-intro"><div><h2>{t('One curriculum. Several ways in.','同一套教材，按自己的需要開始。')}</h2><p>{t('Follow a textbook, use a school learning route, or return to a skill after an examination question. School streams and examination paper codes are separate labels.','可按教材學習、沿校本路徑練習，或由舊卷返回需要鞏固的知識。文理組與聯考卷別分開標記。')}</p></div><div class="senior-stat"><strong>18</strong><span>{t('chapters','章教材')}</span><strong>73</strong><span>{t('textbook section entries','教材節入口')}</span></div></section>
    <section><h2>{t('Textbook learning sequence','按教材學習')}</h2><div class="senior-grid">{books.map((book:any)=><a class="senior-card" href={root+'books/'+book.id+'/'}><span class="eyebrow">{book.chapters} {t('chapters','章')} · {book.sections} {t('sections','節')}</span><h3>{l(book.title)}</h3><p>{chapters.filter((c:any)=>c.bookId===book.id).map((c:any)=>l(c.title)).join(' · ')}</p><span aria-hidden="true">↗</span></a>)}</div></section>
    <section><h2>{t('School learning and revision routes','校本學習與複習路徑')}</h2><p>{t('Routes follow the contents of T01–T06. Revision material does not imply first teaching in that grade. Semester boundaries are not supplied in these sources.','路徑對照 T01–T06 實際內容；複習內容不代表該年首次教授。現有來源未標示上下學期分界。')}</p><div class="senior-grid">{schoolRoutes.map((route:any)=><a class="senior-card" href={root+'paths/'+route.id+'/'}><h3>{l(route.title)}</h3><p>{route.groups.map((g:any)=>l(g.title)).join(' · ')}</p></a>)}</div></section>
    <section><h2>{t('Start with one task','由一個任務開始')}</h2><div class="senior-grid"><a class="senior-card" href={root+'paths/diagnostic/'}><h3>{t('Six starting checks','六題入口檢核')}</h3><p>{t('Find a skill to revisit. Written answers use self-assessment.','找出需要重溫的知識；書面題採用自評。')}</p></a><a class="senior-card" href={root+'papers/'}><h3>2021–2026 · JM01 / JM02</h3><p>{t('Official sources and independently written solutions.','官方來源與獨立編寫的解說。')}</p></a><a class="senior-card" href={zh?'/zh/teaching/jae-math/':'/teaching/jae-math/'}><h3>{t('Original quadratic and trigonometric studio','原有二次與三角研習室')}</h3><p>{t('Your original links and local work remain available.','原有題目連結與本機紀錄繼續可用。')}</p></a></div></section>
  </div>}

  {['book','chapter'].includes(page.type) && <div class="container senior-content"><p>{t('Each section contains concept explanations, three worked examples, ten graded exercises and teacher preparation.','每節包含概念講解、三例題、十分層練習與教師備課內容。')}</p>{page.type==='book' && <nav class="senior-nav">{chapters.filter((c:any)=>c.bookId===item.id).map((chapter:any)=><a href={root+'chapters/'+chapter.id+'/'}>{l(chapter.title)}</a>)}</nav>}<div class="senior-grid">{lessonSelection.map((lesson:any)=><a class="senior-card" href={lessonUrl(lesson.id,locale)}><span class="eyebrow">{lesson.section}</span><h3>{l(lesson.title)}</h3><p>{l(lesson.summary)}</p></a>)}</div>{page.type==='chapter' && <a class="senior-action" href={lessonUrl('review-'+item.id,locale)}>{t('Take the 15-question mixed assessment','開始十五題章節混合評量')} ↗</a>}</div>}

  {page.type==='school' && <div class="container senior-content"><p class="senior-source">{item.filename} · {t('PDF pages count from the first PDF page','PDF 頁碼由檔案第一頁起計')} · {t('Semester boundary not specified','未標示學期分界')}</p>{item.groups.map((group:any)=><section><h2>{l(group.title)}</h2><p class="eyebrow">PDF {group.pdfPage} · {group.role==='review'?t('REVISION','複習'):group.role==='school-practice'?t('SCHOOL ADAPTATIONS','校本類題'):t('LEARNING AND PRACTICE','學習與練習')}</p><div class="senior-grid">{group.lessonIds.map((id:string)=>lessonById.get(id)).filter(Boolean).map((lesson:any)=><a class="senior-card" href={lessonUrl(lesson.id,locale)}><h3>{l(lesson.title)}</h3><p>{l(lesson.summary)}</p></a>)}</div>{group.role==='school-practice' && <p>{t('School adaptations retain their own provenance. Compare genuine past-paper questions with the official archive.','校本類題保留其來源標記；正式舊卷題目請對照官方試卷專區。')} <a href={root+'papers/'}>{t('Open past papers','開啟舊卷')}</a></p>}</section>)}</div>}

  {topic && <>
    <div class="container senior-lesson-context">{page.type==='question' && <a href={item.legacy?(zh?'/zh/teaching/jae-math/':'/teaching/jae-math/')+'#'+item.id:item.paperId?paperUrl(item.paperId,locale)+'#'+item.id:lessonUrl(item.lessonId,locale)+'#'+item.id}>{t('Return to the lesson / paper','返回課節／試卷')} ↗</a>}{page.type==='paper' && <><p>{item.inventory?.choice||0} {t('multiple-choice questions','道選擇題')} · {item.inventory?.writtenTopLevel||0} {t('written questions','道筆答大題')} · {item.inventory?.writtenLeafParts||0} {t('written parts','個筆答小問')}</p>{item.code==='JM02'&&<p>{t('Solutions include all five questions. Follow the original paper’s selection and mark instructions when practising an exam.','詳解涵蓋全部五道大題；模擬考試時，請按原卷的選題及分值指示作答。')}</p>}<a href={item.url} target="_blank" rel="noopener noreferrer">{t('Open official paper and suggested answers','開啟官方試題及參考答案')} ↗</a><p>{t('All listed parts are teaching explanations. Written work uses a reasoning checklist, not automatic official grading.','以下逐小問提供教學解說；書面作答採推理清單，並非官方自動評分。')}</p></>}{lessonItem.source?.documentId && <p class="senior-source">{lessonSourceUrl?<a href={lessonSourceUrl} target="_blank" rel="noopener noreferrer">{lessonSource?.filename}</a>:lessonSource?.filename||lessonItem.source.documentId} · {lessonItem.source.section} · PDF {lessonItem.source.pdfPage} {lessonItem.source.printedPage&&`/ ${t('printed page','印刷頁')} ${lessonItem.source.printedPage}`}</p>}{lessonItem.prerequisites?.length>0 && <p>{t('Revisit first: ','先重溫：')}{lessonItem.prerequisites.filter((id:string)=>lessonById.has(id)).map((id:string)=><a class="senior-chip" href={lessonUrl(id,locale)}>{l(lessonById.get(id).title)}</a>)}</p>}</div>
    {topic.questions.length>0 && <JaeMathStudio locale={locale} lessonTopics={[topic]} standalone />}
    {page.type==='lesson' && <section class="container senior-check" data-lesson-check data-locale={locale}><h2>{t('End-of-lesson check and correction','課末檢核與訂正')}</h2><p>{t('Review your latest checked answers and explanations. A draft change requires a fresh check. Written work needs your self-assessment or a teacher’s review.','回看最近核對的答案及解釋；改動草稿後須重新核對。書面推理需要自評或教師評核。')}</p><p data-lesson-status role="status">{t('Enable JavaScript for a summary of your local work.','啟用 JavaScript 後顯示本機作答摘要。')}</p><script is:inline type="application/json" data-lesson-questions set:html={JSON.stringify(topic.questions.map((q:any)=>({id:q.id,kind:q.kind,level:q.level,url:questionUrl(q.id,locale),prompt:q.prompt}))).replace(/</g,'\\u003c')}/><ul data-lesson-revisit></ul><p><a href={root+'paths/remedial/'}>{t('Choose a foundation skill to revisit','選擇需要重溫的補底知識')} ↗</a></p></section>}
    {lessonItem.teacher && <details class="container senior-teacher" id="teacher"><summary>{t('Teacher preparation and assessment','教師備課與評核')}</summary><div class="senior-grid">{[['prompts','Question sequence','提問順序'],['board','Board plan','板書重點'],['anticipated','Anticipated thinking','預期想法'],['rubric','Assessment checklist','評核清單']].map(([key,en,ch])=><section><h3>{t(en,ch)}</h3><ul>{(lessonItem.teacher[key]||[]).map((entry:any)=><li>{l(entry)}{entry.math && <MathExpression expression={entry.math} display />}</li>)}</ul></section>)}</div></details>}
  </>}

  {page.type==='diagnostic' && <><div class="container senior-content"><p>{t('Attempt one task in each strand without hints. Check the reasoning and return to the linked lesson when needed. These six checks are a starting point, not a diagnosis of the whole curriculum.','每項先不看提示，獨立嘗試一道題，再核對推理並返回相關課節。這六題是學習起點，並非整個課程的能力診斷。')}</p></div><JaeMathStudio locale={locale} lessonTopics={diagnosticTopics} standalone /></>}

  {page.type==='papers' && <div class="container senior-content"><p>{t('Six years, both paper codes. Official papers stay on their original university sites. Each paper’s item inventory determines its format.','六年、兩種卷別；官方試卷保留於大學原網站，每卷格式按原卷逐項記錄。')}</p><div class="senior-grid">{papers.map((paper:any)=><a class="senior-card" href={paperUrl(paper.id,locale)}><p class="eyebrow">{paper.code}</p><h2>{paper.year}</h2><p>{paper.questions.length} {t('question parts with explanations','個題目／小問解說')}</p><span>{paper.status==='complete'?t('Full paper explained','全卷詳解'):t('Verification in progress','正在覆核')}</span></a>)}</div></div>}

  {page.type==='bank' && <div class="container senior-content" data-senior-bank><p>{t('Filter by skill, difficulty, question format or source. A marked completion is your own explanation record.','可按知識點、難度、題型與來源篩選；完成標記代表自己的解釋紀錄。')}</p><form class="senior-filters" data-bank-controls hidden><label>{t('Find a skill or question','搜尋知識點或題目')}<input type="search" data-bank-search /></label><label>{t('Difficulty','難度')}<select data-bank-level><option value="">{t('All','全部')}</option>{['foundation','standard','transfer'].map(level=><option value={level}>{formatLevel(level)}</option>)}</select></label><label>{t('Format','題型')}<select data-bank-kind><option value="">{t('All','全部')}</option><option value="example">{t('Examples','例題')}</option><option value="choice">{t('Multiple choice','選擇')}</option><option value="number">{t('Numeric','數值')}</option><option value="written">{t('Written reasoning','書面推理')}</option></select></label><label>{t('Source','來源')}<select data-bank-source><option value="">{t('All','全部')}</option><option value="original">{t('Original','原創')}</option><option value="official">{t('Official paper','官方試卷')}</option></select></label><label>{t('Textbook / supplement','教材／補充')}<select data-bank-book><option value="">{t('All','全部')}</option>{books.map((book:any)=><option value={book.id}>{l(book.title)}</option>)}<option value="supplement">{t('Supplementary lessons','補充課節')}</option></select></label><label>{t('Examination scope','聯考範圍')}<select data-bank-exam><option value="">{t('All','全部')}</option><option>JM01</option><option>JM02</option></select></label><label>{t('School route (learning / revision)','校本路徑（學習／複習）')}<select data-bank-school><option value="">{t('All','全部')}</option>{schoolRoutes.map((route:any)=><option value={route.id}>{l(route.title)}</option>)}</select></label><label><input type="checkbox" data-bank-wrong />{t('My latest checked wrong answers','我最近核對的錯題')}</label><label><input type="checkbox" data-bank-completed />{t('I marked that I can explain','我已標記能解釋')}</label></form><p data-bank-count role="status">{questions.length} {t('questions','題')}</p><div class="senior-bank-list">{questions.map((question:any)=><a class="senior-bank-row" href={questionUrl(question.id,locale)} data-bank-row data-id={question.id} data-books={bankBooks(question)} data-exams={bankExams(question)} data-schools={bankSchools(question)} data-level={question.level} data-kind={question.kind} data-source={question.source?.type||'original'} data-search={`${l(question.lessonTitle)} ${l(question.prompt)} ${question.id} ${(question.skills||[]).join(' ')}`}><span>{l(question.lessonTitle)} · {formatLevel(question.level)}</span><strong>{l(question.prompt)}</strong><small>{question.source?.type==='official'?question.paperId:t('Original teaching material','原創教學材料')} · {question.kind==='written'?t('Reasoning checklist','推理清單'):question.kind==='example'?t('Worked example','例題'):t('Answer check','答案核對')}</small></a>)}</div></div>}

  {page.type==='remedial' && <div class="container senior-content"><h2>{t('Start from the missing skill','由缺失的知識點開始')}</h2><ol class="senior-route-steps"><li><a href={root+'paths/diagnostic/'}>{t('Try six starting checks','嘗試六題入口檢核')}</a></li><li>{t('Return to the concepts and foundation examples of the relevant lesson.','返回相關課節的概念與基礎例題。')}</li><li>{t('Attempt the four foundation exercises, then the standard and transfer tasks.','先做四道基礎練習，再嘗試鞏固與遷移題。')}</li><li><a href={root+'question-bank/?wrong=1'}>{t('Revisit your latest checked wrong answers and write a correction.','重做最近核對的錯題，並寫下訂正理由。')}</a></li></ol><div class="senior-grid">{lessons.map((lesson:any)=><a class="senior-card" href={lessonUrl(lesson.id,locale)}><h3>{l(lesson.title)}</h3><p>{l(lesson.objectives?.[0]||lesson.summary)}</p></a>)}</div></div>}

  {page.type==='exam' && <div class="container senior-content"><p>{t('Use the syllabus for your examination year. A school’s arts/science stream does not determine a paper code.','應考時以該年度大綱為準；學校文理組不決定聯考卷別。')}</p><nav class="senior-nav">{syllabusSources.map((source:any)=><a href={source.url} target="_blank" rel="noopener noreferrer">2027 {source.code} {t('syllabus','大綱')} ↗</a>)}</nav><ol class="senior-route-steps"><li>{t('Read a worked example and explain its conditions.','閱讀例題，說明成立條件。')}</li><li>{t('Complete standard and transfer exercises without hints.','不看提示完成鞏固與遷移練習。')}</li><li>{t('Use a chapter mixed assessment to choose methods independently.','透過章節混合評量獨立選擇方法。')}</li><li><a href={root+'papers/'}>{t('Attempt the original paper, then compare every step and revise.','嘗試原卷，再逐步對照並訂正。')}</a></li></ol><SeniorMathExamMap locale={locale}/><div class="senior-grid">{chapters.map((chapter:any)=><a class="senior-card" href={root+'chapters/'+chapter.id+'/'}><h3>{l(chapter.title)}</h3><p>{t('Lessons and 15-question mixed assessment','課節與十五題混合評量')}</p></a>)}{lessons.filter((lesson:any)=>lesson.bookId==='supplement').map((lesson:any)=><a class="senior-card" href={lessonUrl(lesson.id,locale)}><h3>{l(lesson.title)}</h3><p>{l(lesson.summary)}</p></a>)}</div></div>}

  {page.type==='teacher' && <div class="container senior-content"><p>{t('Choose a lesson to use its question sequence, board plan, anticipated answers and reasoning rubric. Classroom mode shows one question at a time; print student or teacher versions from the lesson tools.','選擇課節使用提問順序、板書重點、預期答案與推理清單。課堂模式一次展示一道題；課節工具可列印學生版或教師版。')}</p><div class="senior-grid">{lessons.map((lesson:any)=><a class="senior-card" href={lessonUrl(lesson.id,locale)+'#teacher'}><h3>{l(lesson.title)}</h3><p>{l(lesson.teacher?.prompts?.[0]||lesson.objectives?.[0]||lesson.summary)}</p></a>)}</div></div>}

  {page.type==='sources' && <div class="container senior-content"><h2>{t('Sources and authorship','來源與編寫')}</h2><p>{t('The five A-series textbooks define the textbook sequence; six school thinking workbooks define the school routes. Public explanations and graded exercises are independently authored. Original PDFs are not republished here.','五冊 A 版教材確定教材主線，六冊思維本確定校本路徑。公開解說與分層練習獨立編寫；原 PDF 不在此重新上載。')}</p><ul>{books.map((book:any)=><li>{book.filename} · {book.pdfPages} PDF {t('pages','頁')}</li>)}{schoolRoutes.map((route:any)=><li>{route.filename} · {route.pdfPages} PDF {t('pages','頁')}</li>)}</ul><p>{t('PDF page numbers and printed page numbers are recorded separately. Contents and actual section starts are cross-checked; A/B exercise parts are not textbook editions or semester labels. School adaptations remain distinct from official examination questions.','PDF 頁碼與印刷頁碼分開記錄，並核對目錄與實際章節起點。習題 A／B 部不是教材版本或學期標籤；校本類題與正式聯考題分開。')}</p><h3>{t('Source discrepancies','來源差異')}</h3><p>{t('T01 includes surface-area exercises that are absent from its contents list. A parabola has a vertex but no centre of symmetry; school wording using “centre” is clarified in the conic lesson. Paper-specific discrepancies are recorded with the affected solutions.','T01 內文包含目錄未列出的表面積練習。拋物線有頂點，沒有對稱中心；校本題目「中心」用語會在圓錐曲線課節澄清。個別試卷差異記錄於相關詳解。')}</p></div>}
  <footer class="container senior-footnote"><p>{t('No sign-in. Work stays in this browser. Export before clearing browser data. Written reasoning is assessed with a checklist.','免登入，紀錄保存在此瀏覽器；清除資料前請先匯出。書面推理按清單自評或由教師評核。')}</p><a href={root+'sources/'}>{t('Curriculum and source notes','教材與來源說明')} ↗</a></footer>
</div>
<script>
  import { initializeSeniorBank } from '../scripts/senior-math-bank-ui';
  import { initializeSeniorChecks } from '../scripts/senior-math-check-ui';
