---
import MathExpression from './MathExpression.astro';
import TeachingToolbar from './TeachingToolbar.astro';
import SeniorMathInquiry from './SeniorMathInquiry.astro';
import { jaeTopics, jaeSyllabus } from '../data/jae-math.mjs';
import '../styles/jae-math.css';

interface Props { locale?: 'en' | 'zh-Hant'; lessonTopics?: any[]; standalone?: boolean }
const { locale = 'en', lessonTopics, standalone = false } = Astro.props;
const zh = locale === 'zh-Hant';
const t = (en: string, ch: string) => zh ? ch : en;
const label = (value: any) => value?.[zh ? 'zh' : 'en'] || '';
const topics = (lessonTopics || jaeTopics.map(topic=>({...topic,questions:topic.questions.map(question=>({...question,difficultyReview:'provisional'}))}))) as any[];
const levels: Record<string, string> = { foundation: t('Foundation', '基礎'), standard: t('Standard', '鞏固'), transfer: t('Transfer', '遷移') };
---

<script is:inline src="/math-shared/storage.js"></script>
<div class="jae-studio" data-jae-studio data-locale={locale} data-mode="study" data-print="student">
  <script is:inline type="application/json" data-jae-data set:html={JSON.stringify(topics).replace(/</g, '\\u003c')} />
  {!standalone && <TeachingToolbar locale={locale} questionIds={topics.flatMap(topic => topic.questions.map((question: any) => question.id))} />}
  {!standalone && <header class="jae-hero">
    <div class="container jae-hero-grid">
      <div>
        <a class="jae-back" href={zh ? '/zh/teaching/senior-math/' : '/teaching/senior-math/'}>← {t('Senior Mathematics Studio', '高中數學研習室')}</a>
        <p class="jae-eyebrow">MACAU · JOINT ADMISSION EXAMINATION</p>
        <h1>{t('Understand the move.\nThen solve the problem.', '先看懂關鍵，\n再解好每一題。')}</h1>
        <p class="jae-lead">{t('A mathematics studio for Macau JAE: explore a graph, explain a method, and make your next attempt more deliberate.', '澳門四校聯考數學研習室：從圖像理解關係，用提示整理思路，再透過練習與訂正掌握方法。')}</p>
        <div class="jae-hero-links"><a href="#jae-topics">{t('Explore the two topics', '開始兩個專題')} <span aria-hidden="true">↗</span></a><a href={zh?'/zh/teaching/senior-math/':'/teaching/senior-math/'}>{t('Full senior curriculum', '完整高中課程')} ↗</a><a href={zh?'/zh/teaching/senior-math/papers/':'/teaching/senior-math/papers/'}>{t('2021–2026 JM01 / JM02 explanations', '2021–2026 正卷／附加卷詳解')} ↗</a></div>
      </div>
      <aside class="jae-hero-note" aria-label={t('Learning sequence', '學習次序')}>
        <span class="jae-note-mark" aria-hidden="true">ƒ</span>
        <p class="jae-eyebrow">{t('SMALL STEPS · CLEAR REASONING', '每一步，都有理由')}</p>
        <ol><li><b>01</b><span>{t('Predict what will change', '先預測，留下想法')}</span></li><li><b>02</b><span>{t('Observe and explain', '操作圖像，解釋關係')}</span></li><li><b>03</b><span>{t('Attempt, compare, revise', '獨立解題，對照與訂正')}</span></li></ol>
        <p>{t('No sign-in. Your work stays in this browser.', '免登入。學習紀錄只保存在此瀏覽器。')}</p>
      </aside>
    </div>
  </header>}

  <div class="jae-commandbar" data-jae-controls hidden>
    <div class="container jae-command-inner">
      <div class="jae-mode-switch" role="group" aria-label={t('Learning mode', '學習模式')}>
        <button type="button" data-mode-button="study" aria-pressed="true">{t('Study', '自主學習')}</button>
        <button type="button" data-mode-button="classroom" aria-pressed="false">{t('Classroom', '課堂授課')}</button>
      </div>
      <p class="jae-save-status" data-save-status role="status">{t('Reading local work…', '正在讀取本機紀錄…')}</p>
      <details class="jae-tools"><summary>{t('Export & print', '匯出與列印')}</summary><div class="jae-tools-menu">
        <button type="button" data-export="json">{t('Download JSON', '下載 JSON 紀錄')}</button><button type="button" data-export="text">{t('Download readable record', '下載文字紀錄')}</button>
        <button type="button" data-print="student">{t('Print student worksheet', '列印學生練習紙')}</button><button type="button" data-print="teacher">{t('Print teacher solutions', '列印教師解答')}</button>
        <button type="button" data-print="work">{t('Print my work and corrections','列印我的作答與訂正')}</button><a href={zh?'/zh/teaching/senior-math/my-learning/':'/teaching/senior-math/my-learning/'}>{t('Restore a backup / My learning','還原備份／我的學習')}</a>
      </div></details>
    </div>
  </div>

  <div class="container jae-main" id="jae-topics">
    {!standalone && <div class="jae-section-heading"><div><p class="jae-eyebrow">{t('TWO COMPLETE STARTING POINTS', '先把兩個專題學紮實')}</p><h2>{t('A route from ideas to answers.', '由概念，走到解題。')}</h2></div><p>{t('Original teaching examples with layered hints. Continue to the shared paper library below for official sources and explanations.', '原創例題配合分層提示；頁末可進入舊卷資源庫，銜接官方原卷及詳解。')}</p></div>}
    <nav class="jae-topic-nav" aria-label={t('Topics', '專題')}>
      {topics.map((topic: any, index: number) => <a href={`#${topic.id}`} data-topic-link={topic.id}><span>0{index + 1}</span><strong>{label(topic.title)}</strong><small>{label(topic.summary)}</small><b aria-hidden="true">↗</b></a>)}
    </nav>

    <section class="jae-classroom-controls" aria-label={t('Classroom controls', '課堂控制')} data-classroom-controls hidden>
      <div class="jae-classroom-top"><label for="jae-directory">{t('Question directory', '題目目錄')}<select id="jae-directory" data-directory>{topics.map((topic: any) => <optgroup label={label(topic.title)}>{topic.questions.map((question: any, index: number) => <option value={question.id}>{`${index + 1}. ${levels[question.level] || ''} · ${label(question.prompt).slice(0, 65)}`}</option>)}</optgroup>)}</select></label><div class="jae-nav-buttons"><button type="button" data-question-nav="prev" aria-label={t('Previous question', '上一題')}>←</button><span data-question-position aria-live="polite"></span><button type="button" data-question-nav="next" aria-label={t('Next question', '下一題')}>→</button></div></div>
      <div class="jae-classroom-toolbar"><div class="jae-toolbar-group"><button type="button" class="jae-button" data-reveal-next>{t('Reveal next hint', '顯示下一個提示')}</button><button type="button" data-reveal-reset>{t('Hide hints', '收起提示')}</button><button type="button" data-toggle-graph aria-pressed="false">{t('Graph lab', '互動圖像')}</button></div><div class="jae-toolbar-group"><button type="button" data-zoom>{t('Enlarge question', '放大題目')}</button><button type="button" data-fullscreen>{t('Full screen', '全螢幕')}</button></div></div>
      <div class="jae-annotation-toolbar"><span>{t('Annotate', '標記')}</span><div role="group" aria-label={t('Annotation tool', '標記工具')}><button type="button" data-draw-tool="select" aria-pressed="true">{t('Select', '選取')}</button><button type="button" data-draw-tool="pen" aria-pressed="false">{t('Pen', '畫筆')}</button><button type="button" data-draw-tool="laser" aria-pressed="false">{t('Laser', '雷射筆')}</button></div><label>{t('Colour', '顏色')}<select data-pen-color aria-label={t('Pen colour', '畫筆顏色')}><option value="#bc3c36">{t('Red', '紅色')}</option><option value="#176853">{t('Green', '綠色')}</option><option value="#2753a5">{t('Blue', '藍色')}</option><option value="#9b6412">{t('Gold', '金色')}</option></select></label><button type="button" data-clear-ink>{t('Clear this question', '清除此題筆跡')}</button><small>{t('← / →: change question · Space: next hint · Ink lasts for this session only.', '← / → 換題 · 空白鍵顯示提示 · 筆跡只保留於本次瀏覽。')}</small></div>
    </section>

    {topics.map((topic: any, topicIndex: number) => <section class="jae-topic" id={topic.id} data-topic={topic.id}>
      <header class="jae-topic-heading"><p class="jae-eyebrow">{t('TOPIC', '專題')} 0{topicIndex + 1}</p><h2>{label(topic.title)}</h2><p>{label(topic.summary)}</p></header>
      {(topic.objectives.length>0||topic.concepts.length>0||topic.misconceptions.length>0) && <div class="jae-topic-reading">
        <div class="jae-objectives"><h3>{t('What you will be able to explain', '學完之後，你能解釋')}</h3><ul>{topic.objectives.map((objective: any) => <li>{label(objective)}</li>)}</ul></div>
        <div class="jae-concepts">{topic.concepts.map((concept: any) => <article><h3>{label(concept.title)}</h3>{concept.motivation&&<p>{label(concept.motivation)}</p>}<p>{label(concept.body)}</p>{concept.formula && <MathExpression expression={concept.formula} display />}{concept.derivation?.length>0&&<ol>{concept.derivation.map((step:any)=><li><p>{label(step.body)}</p>{step.math&&<MathExpression expression={step.math} display/>}</li>)}</ol>}{concept.conditions?.length>0&&<><h4>{t('When it applies','成立條件')}</h4><ul>{concept.conditions.map((v:any)=><li>{label(v)}</li>)}</ul></>}{concept.counterexample&&<p><strong>{t('Counterexample: ','反例：')}</strong>{label(concept.counterexample)}</p>}{concept.representations?.length>0&&<ul>{concept.representations.map((v:any)=><li>{label(v)}</li>)}</ul>}</article>)}</div>
        <aside class="jae-misconceptions"><h3>{t('Pause at these common mistakes', '這些地方，值得停一停')}</h3><ul>{topic.misconceptions.map((item: any) => <li>{label(item)}</li>)}</ul></aside>
      </div>}

      {topic.inquiry && <SeniorMathInquiry inquiry={topic.inquiry} locale={locale} lessonId={topic.id} />}
      {['quadratics', 'trigonometry'].includes(topic.id) && <section class="jae-graph-lab" data-graph-section data-graph={topic.id} aria-label={t('Interactive graph', '互動圖像')}>
        <div class="jae-lab-head"><p class="jae-eyebrow">{t('PREDICT → MOVE → EXPLAIN', '預測 → 操作 → 解釋')}</p><h3>{topic.id === 'quadratics' ? t('What does each coefficient change?', '每個係數，改變了甚麼？') : t('See amplitude, period and phase together.', '把振幅、週期與相位一起看清。')}</h3><p>{topic.id === 'quadratics' ? t('Before moving a slider, predict the opening, vertex and intercepts. Then compare the graph with your prediction.', '移動滑桿前，先預測開口、頂點與截距會怎樣改變，再用圖像檢查。') : t('Predict the number of cycles and the horizontal shift. Switch angle units without changing the curve.', '先預測完整波形的個數與左右平移方向，再切換角度單位比較同一條曲線。')}</p></div>
        <div class="jae-lab-layout"><div class="jae-plot"><svg viewBox="0 0 640 360" role="img" aria-label={topic.id === 'quadratics' ? t('Quadratic graph; interactive controls below', '二次函數圖像；下方設有互動控制') : t('Trigonometric graph; interactive controls below', '三角函數圖像；下方設有互動控制')} data-plot><title>{t('Enable JavaScript to explore the graph.', '啟用 JavaScript 後可探索圖像。')}</title><rect width="640" height="360" fill="#fbfcf7"/><path d="M 40 180 H 620 M 320 20 V 335" stroke="#a8b8ae"/><text x="320" y="160" text-anchor="middle" fill="#596c62" font-size="16">{t('Interactive graph loads here', '互動圖像會在此顯示')}</text></svg><p class="jae-graph-description" data-graph-description aria-live="polite"></p></div>
        <div class="jae-graph-controls" data-interactive-only hidden>
          {topic.id === 'quadratics' ? <><p class="jae-lab-formula"><MathExpression expression="y=ax^2+bx+c" /></p>{[['a', -3, 3, .5, 1], ['b', -6, 6, .5, -2], ['c', -6, 6, .5, -3]].map(([key, min, max, step, value]) => <label>{String(key)}<output data-value={key}>{value}</output><input type="range" data-param={key} min={min} max={max} step={step} value={value} aria-label={`${key}`} /></label>)}</> : <><p class="jae-lab-formula"><span data-trig-formula="sin"><MathExpression expression={String.raw`y=A\sin(kx+\varphi)`} /></span><span data-trig-formula="cos" hidden><MathExpression expression={String.raw`y=A\cos(kx+\varphi)`} /></span></p><label>{t('Function', '函數')}<select data-param="kind"><option value="sin">sin</option><option value="cos">cos</option></select></label>{[['amplitude', t('Amplitude A', '振幅參數 A'), -3, 3, .5, 1], ['frequency', t('Frequency k', '頻率參數 k'), 0, 3, .5, 1], ['phase', t('Phase φ', '相位 φ'), -180, 180, 15, 0]].map(([key, name, min, max, step, value]) => <label>{name}<output data-value={key}>{value}</output><input type="range" data-param={key} min={min} max={max} step={step} value={value} aria-label={String(name)} /></label>)}<label>{t('Angle labels', '角度標示')}<select data-param="units"><option value="degrees">{t('Degrees (°)', '角度（°）')}</option><option value="radians">{t('Radians (rad)', '弧度（rad）')}</option></select></label></>}
          <button type="button" data-reset-graph>{t('Reset graph', '重設圖像')}</button>
        </div></div>
        <noscript><p>{t('The lessons and worked solutions remain available below. Graph controls require JavaScript.', '下方課文及完整解答仍可閱讀；圖像操作需要 JavaScript。')}</p></noscript>
      </section>}

      <div class="jae-exercise-heading"><h3>{t('Try it. Leave your reasoning visible.', '試一試，把思路寫下來。')}</h3><p>{t('Use one hint at a time. A correction explains what changed, not just the final answer.', '每次只看一個提示。訂正時記錄想法如何改變，不只抄下答案。')}</p></div>
      {topic.questions[0]?.id.startsWith('skill-')&&<p class="senior-scaffolding">{t('Examples 1–3: study a full demonstration; finish a solution from its first step; then choose a method independently before opening the solution. The remaining exercises may continue after class.','例題 1–3：先讀完整示範；由已完成的首步接續推理；再獨立選方法，完成後才展開解答。其餘練習可於課後繼續。')}</p>}
      <div class="jae-questions">{topic.questions.map((question: any, index: number) => <article class="jae-question" id={question.id} data-question={question.id} data-question-topic={topic.id}>
        <div class="jae-question-stage"><div class="jae-question-left">
          <div class="jae-question-meta"><span>{String(index + 1).padStart(2, '0')} / {question.difficultyReview==='ungraded'?t('Ungraded','未分級'):(levels[question.level] || '')+(question.difficultyReview==='provisional'?t(' · provisional',' · 暫定'):'')}</span><a href={question.permalink || `#${question.id}`} aria-label={t('Link to this question', '此題連結')}>#</a><span>{question.kind === 'example' ? t('Worked example', '示範例題') : t('Your turn', '獨立練習')}</span></div>
          {question.sharedStem?.segments.length>0&&<aside class="senior-shared-stem"><h5>{t('Shared conditions and earlier statements','共用條件與前置題意')}</h5><p>{t('Read the shared conditions and earlier tasks. Their solutions are not included here; derive any needed result yourself.','請閱讀共用條件及前面小問；此處不展示解答，需要的結果請自行推導。')}</p>{question.sharedStem.segments.map((part:any)=><div><strong>{part.id.startsWith('context-')?t('Given context','已知條件'):part.label}</strong><p>{label(part.prompt)}</p>{part.expression&&<MathExpression expression={part.expression} display/>}{part.conditions?.length>0&&<ul>{part.conditions.map((c:any)=><li>{label(c)}</li>)}</ul>}{part.promptSvg&&<div class="senior-prompt-svg" set:html={part.promptSvg}/>}</div>)}</aside>}
          <h4>{label(question.prompt)}</h4>{question.expression && <MathExpression expression={question.expression} display />}
          {index===1&&question.id.startsWith('skill-')&&question.kind==='example'&&<div class="senior-partial-solution"><p><strong>{t('First step provided — complete the reasoning:','已提供首步，請接續推理：')}</strong>{label(question.steps[0].body)}</p>{question.steps[0].math&&<MathExpression expression={question.steps[0].math} display/>}</div>}
          {question.promptSvg && <div class="senior-prompt-svg" set:html={question.promptSvg} />}
          {question.sourceDiscrepancy && <aside class="senior-discrepancy">{label(question.sourceDiscrepancy)}</aside>}
          {question.conditions?.length > 0 && <ul class="jae-conditions">{question.conditions.map((condition: any) => <li>{label(condition)}</li>)}</ul>}
          {question.source?.type === 'official' && <p class="senior-question-source">{t('Official paper', '官方試卷')} · {question.source.paperId} · {question.source.question} · PDF {question.source.pdfPage}</p>}
          {question.officialUrl && <p><a href={question.officialUrl} target="_blank" rel="noopener noreferrer">{t('Official original and suggested answers','官方原卷及參考答案')} ↗</a> · {t('Suggested answer PDF page','參考答案 PDF 頁')} {question.source.answerPdfPage}</p>}
          {question.relatedLessons?.length>0 && <details class="senior-question-skills"><summary>{t('Skills and prerequisite lessons','考點與先備課節')}</summary><nav>{question.relatedLessons.map((lesson:any)=><a class="senior-chip" href={lesson.url}>{label(lesson.title)}</a>)}</nav></details>}
          {question.relatedSkills?.length>0&&<nav aria-label={t('Targeted skill support','技能補救')}>{question.relatedSkills.map((skill:any)=><a class="senior-chip" href={skill.url}>{label(skill.title)}</a>)}</nav>}
          {question.examScopes&&<p class="senior-question-source">{t('Scope: ','範圍：')}{question.examScopes.filter((s:string)=>s!=='extension').join(' / ')||t('School extension','校本延伸')}{question.examScopeNote&&<> · {label(question.examScopeNote)}</>}</p>}
          <button type="button" data-classroom-add={question.id} data-interactive-only hidden>{t('Add to classroom list','加入課堂清單')}</button>
          {question.kind === 'choice' && <div class="jae-static-options"><ol type="A">{question.choices?.map((choice: any) => <li>{label(choice.label)}{choice.expression && <MathExpression expression={choice.expression} />}</li>)}</ol></div>}
          {question.kind !== 'example' && <form class="jae-answer-form" data-answer-form data-interactive-only hidden>
            {question.kind === 'choice' ? <fieldset><legend>{t('Choose an answer', '選擇答案')}</legend><div class="jae-options">{question.choices?.map((choice: any) => <label><input type="radio" name={`answer-${question.id}`} value={choice.id} /><span><b>{choice.id}</b> {label(choice.label)}{choice.expression && <MathExpression expression={choice.expression} />}</span></label>)}</div></fieldset> : question.kind !== 'written' && <label class="jae-answer-label" for={`answer-${question.id}`}>{t('Your answer (e.g. 3/2, pi/3, sqrt(2))', '你的答案（例如 3/2、pi/3、sqrt(2)）')}<input id={`answer-${question.id}`} type="text" inputmode="text" autocomplete="off" data-number-answer placeholder={t('Enter a number', '輸入數值')} /></label>}
            {question.kind === 'written' && <label>{t('Written reasoning for self-assessment', '書面推理與自評')}<textarea data-written-answer maxlength="6000" rows="4"></textarea></label>}
            <button class="jae-button" type="submit">{question.kind === 'written' ? t('Record my work', '記錄我的作答') : t('Check answer', '核對答案')}</button><p class="jae-answer-feedback" data-answer-feedback role="status"></p>
          </form>}
          <div class="jae-study-record" data-interactive-only hidden><label for={`notes-${question.id}`}>{t('My reasoning / first attempt', '我的思路／初次嘗試')}<textarea id={`notes-${question.id}`} data-record="notes" rows="3" maxlength="6000" placeholder={t('What did you notice? Which method did you try?', '你留意到甚麼？嘗試用了哪個方法？')}></textarea></label><label for={`correction-${question.id}`}>{t('My correction', '我的訂正')}<textarea id={`correction-${question.id}`} data-record="correction" rows="2" maxlength="6000" placeholder={t('What changed, and why?', '哪一步要修改？原因是甚麼？')}></textarea></label><label class="jae-completion"><input type="checkbox" data-completed />{t('I can explain this solution', '我能解釋這題的解法')}</label></div>
          <section class="senior-learning-tools" data-interactive-only hidden><p data-evidence role="status"></p><fieldset><legend>{t('What needed correction?','訂正哪方面？')}</legend>{[['conditions','Conditions / domain','條件／定義域'],['method','Method selection','方法選擇'],['algebra','Algebra / signs','代數符號'],['missing-solutions','Missing solutions','漏解'],['diagram','Graph','圖像'],['expression','Explanation','表達']].map(([key,en,ch])=><label><input type="checkbox" data-error-category value={key}/>{t(en,ch)}</label>)}</fieldset><p><button type="button" data-review-days="3">{t('Retry in 3 days','三天後重做')}</button> <button type="button" data-review-days="7">{t('Retry in 7 days','七天後重做')}</button> <button type="button" data-independent-retry>{t('Start an independent retry','開始獨立重做')}</button></p><p data-review-due></p><details><summary>{t('Recent attempts (up to five)','最近作答（最多五次）')}</summary><ol data-attempt-history></ol></details></section>
          <pre class="jae-print-record" data-print-record></pre>
          <div data-correction-support></div>
          <div class="jae-print-working"><p>{t('Working and explanation', '計算過程與解釋')}</p><div></div></div>
        </div><div class="jae-question-right">
          <p class="jae-reasoning-label">{t('BUILD THE REASONING', '逐步建立思路')}</p>
          {question.hints.map((hint: any, hintIndex: number) => <details class="jae-reveal jae-hint" data-reveal={hintIndex + 1}><summary>{t('Hint', '提示')} {hintIndex + 1}<span aria-hidden="true">+</span></summary><div>{label(hint)}{hint.math && <MathExpression expression={hint.math} display />}</div></details>)}
          <details class="jae-reveal jae-solution" data-reveal="3"><summary>{t('Worked solution', '完整解答')}<span aria-hidden="true">+</span></summary><div><ol>{question.steps.map((step: any) => <li><p>{label(step.body)}</p>{step.math && <MathExpression expression={step.math} display />}</li>)}</ol>{question.solutionSvg && <div class="senior-solution-svg" set:html={question.solutionSvg} />}<p class="jae-result">{label(question.result)}</p>{question.resultMath&&<MathExpression expression={question.resultMath} display/>}<p><strong>{t('Checks and common pitfalls: ','檢查與易錯點：')}</strong>{label(question.explanation)}</p></div></details>
          {question.rubric?.length > 0 && <details class="jae-rubric"><summary>{t('Reasoning checklist · self / teacher assessment', '推理清單・自評／教師評核')}</summary><ul>{question.rubric.map((item: any) => <li>{label(item)}{item.math&&<MathExpression expression={item.math} display/>}</li>)}</ul></details>}
          <p class="jae-classroom-wait">{t('Think first. Reveal a hint when the class is ready.', '先思考，待同學準備好再展開提示。')}</p>
        </div><canvas class="jae-ink" aria-hidden="true" data-ink></canvas></div>
      </article>)}</div>
    </section>)}

    {!standalone && <section id="past-papers" class="jae-paper-section">
      <div class="jae-section-heading"><div><p class="jae-eyebrow">2021–2026 · JM01 / JM02 · {t('OFFICIAL SOURCES', '官方來源')}</p><h2>{t('Take the next step\nwith a past paper.', '再用一份舊卷，\n檢查自己的理解。')}</h2></div><p>{t('Open the official source, attempt the questions independently, and return to your notes to identify the next skill to practise.', '開啟官方來源，先獨立作答，再回看學習紀錄，找出下一步要鞏固的知識。')}</p></div>
      <a class="button" href={zh ? '/zh/teaching/senior-math/papers/' : '/teaching/senior-math/papers/'}>{t('Browse all 12 papers and explanations', '瀏覽全部 12 份舊卷及詳解')} ↗</a>
      <p class="jae-syllabus">{t('Each paper page links to the official original and suggested answers, with its source verification date.', '每份試卷頁均提供官方原卷、參考答案連結及來源核對日期。')}</p>
      <p class="jae-syllabus"><a href={jaeSyllabus.url} target="_blank" rel="noopener noreferrer">{jaeSyllabus.year} {t('official mathematics syllabus', '官方數學考試大綱')} ↗</a><span>{t('Check the syllabus for the year in which you sit the examination.', '應考時，請以該年度正式大綱為準。')}</span></p>
      <aside class="jae-source-note"><h3>{t('About this teaching resource', '關於這份教學資源')}</h3><p>{t('An independent, unofficial teaching resource by Kenneth Cheng. Lessons and exercises are original; official examination papers remain on their original sites. This page contains two starting topics; the Senior Mathematics Studio provides the wider curriculum and paper explanations.', '這是 Kenneth Cheng 編寫的獨立、非官方教學資源。課文與練習為原創；官方試卷保留於原網站。本頁提供兩個入門專題；高中數學研習室提供完整課程入口與舊卷詳解。')}</p><p>{t('Saved answers are local to this browser; there is no teacher dashboard or cross-device sync. Export your record before clearing browser data.', '答案與訂正只保存在此瀏覽器，沒有教師後台或跨裝置同步。清除瀏覽器資料前，請先匯出紀錄。')}</p></aside>
    </section>}
  </div>
  <dialog class="jae-zoom-dialog" data-zoom-dialog aria-label={t('Enlarged question', '放大題目')}><div class="jae-zoom-header"><p>{t('Focus on one question', '專注一道題目')}</p><button type="button" data-zoom-close>{t('Close · Esc', '關閉 · Esc')}</button></div><div data-zoom-content></div></dialog>
  <noscript><div class="container jae-noscript">{t('You can read all lessons, questions and expandable solutions without JavaScript. Answer checking, local saving and classroom tools require JavaScript.', '不用 JavaScript 亦可閱讀全部課文、題目及展開解答。答案核對、本機保存及課堂工具需要 JavaScript。')}</div></noscript>
</div>
<script>
  import { initializeJaeMath } from '../scripts/jae-math-ui';
  document.querySelectorAll<HTMLElement>('[data-jae-studio]').forEach(initializeJaeMath);
</script>
