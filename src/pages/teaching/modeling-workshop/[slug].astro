---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WorkshopLesson from "../../../components/WorkshopLesson.astro";
import {lessons} from "../../../data/workshop-lessons";
export function getStaticPaths(){return lessons.map(lesson=>({params:{slug:lesson.slug},props:{lesson}}));}
const {lesson}=Astro.props;
---
<BaseLayout title={lesson.title.en} description={lesson.summary.en} type="Teaching" alternatePath={`/zh/teaching/modeling-workshop/${lesson.slug}/`}><WorkshopLesson lesson={lesson} locale="en"/></BaseLayout>
