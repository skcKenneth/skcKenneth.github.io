---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  return (await getCollection("researchZh", ({ data }) => !data.draft))
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  type="研究"
  locale="zh-Hant"
  alternatePath={`/research/${entry.data.sourceSlug}/`}
>
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">研究方向</p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.summary}</p>
    </div>
  </header>
  <div class="container content-shell">
    <aside>
      <h2>研究問題</h2>
      <ul>{entry.data.questions.map((question) => <li>{question}</li>)}</ul>
      <h3>方法</h3>
      <div class="tag-list">{entry.data.methods.map((method) => <span class="tag">{method}</span>)}</div>
    </aside>
    <article class="prose">
      <Content />
      <h2>相關專案</h2>
      <p><a href={`/zh/projects/?topic=${encodeURIComponent(entry.data.programme)}`}>瀏覽這個研究方向的專案</a>。</p>
    </article>
  </div>
</BaseLayout>

