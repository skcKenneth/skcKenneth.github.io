---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteSearch from "../../components/SiteSearch.astro";
---
<BaseLayout
  title="搜尋"
  description="搜尋繁體中文研究、專案、文章及教學材料。"
  type="搜尋"
  locale="zh-Hant"
  alternatePath="/search/"
>
  <header class="page-head"><div class="container">
    <p class="eyebrow">搜尋</p>
    <h1>尋找一個概念、方法或專案。</h1>
    <p class="lead">索引涵蓋研究、專案、文章與教學；重定向及重複頁面不會列入。</p>
  </div></header>
  <SiteSearch locale="zh-Hant"/>
</BaseLayout>

