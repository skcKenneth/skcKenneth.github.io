---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteSearch from "../../components/SiteSearch.astro";
---
<BaseLayout
  title="搜尋"
  description="搜尋繁體中文文章、專案與教學，亦可選擇典藏與技術資源。"
  type="搜尋"
  locale="zh-Hant"
  alternatePath="/search/"
>
  <header class="page-head"><div class="container">
    <p class="eyebrow">搜尋</p>
    <h1>由一個問題開始探索。</h1>
    <p class="lead">找一篇文章、探索專案，或返回教學資源；你可以選擇搜尋範圍。</p>
  </div></header>
  <SiteSearch locale="zh-Hant"/>
</BaseLayout>

