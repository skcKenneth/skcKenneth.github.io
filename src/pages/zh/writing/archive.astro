---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WritingIndex from '../../../components/WritingIndex.astro';
const entries = await getCollection('writingZh', ({ data }) => !data.draft && data.slug !== 'legacy-archive');
---
<BaseLayout title="文章典藏" description="完整文章典藏，標明日期、閱讀時間與過往內容狀態。" type="文章" locale="zh-Hant" alternatePath="/writing/archive/"><WritingIndex entries={entries} locale="zh-Hant" includeArchive /></BaseLayout>
