---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WritingIndex from '../../../components/WritingIndex.astro';
const entries = await getCollection('writingZh', ({ data }) => !data.draft && data.slug !== 'legacy-archive');
---
<BaseLayout title="文章" description="按主題、類型或年份探索數學思考、計算實驗與教學文章。" type="文章" locale="zh-Hant" alternatePath="/writing/"><WritingIndex entries={entries} locale="zh-Hant" /></BaseLayout>
