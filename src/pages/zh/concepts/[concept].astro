---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ConceptPage from '../../../components/ConceptPage.astro';
import { CONCEPTS } from '../../../data/reader-concepts.mjs';
export async function getStaticPaths() {
  const entries = await getCollection('writingZh',({data})=>!data.draft);
  return CONCEPTS.map(concept=>({params:{concept:concept.id},props:{concept,entries}}));
}
const {concept,entries} = Astro.props;
---
<BaseLayout title={`${concept.label['zh-Hant']} — 概念導讀`} description={concept.copy['zh-Hant'].definition} type="Concept guides" topicIds={concept.topicIds} locale="zh-Hant" alternatePath={`/concepts/${concept.id}/`}><ConceptPage conceptId={concept.id} entries={entries} locale="zh-Hant" /></BaseLayout>
