---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ReadingPathsIndex from '../../../../components/ReadingPathsIndex.astro';
import { READING_PATHS } from '../../../../data/reading-paths.mjs';
const entries = await getCollection('writingZh', ({ data }) => !data.draft && !data.archived && data.slug !== 'legacy-archive');
const topicIds = [...new Set(READING_PATHS.flatMap(path => path.topicIds))];
---
<BaseLayout title="閱讀路線" description="兩條由已發布文章組成的閱讀路線，每一步列明目的、先備概念與證據界限。" type="Reading guides" topicIds={topicIds} locale="zh-Hant" alternatePath="/topics/routes/"><ReadingPathsIndex entries={entries} locale="zh-Hant" /></BaseLayout>
