---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import ClassroomPackPage from '../../../../../components/ClassroomPackPage.astro';
import { CLASSROOM_PACKS, classroomPackHref } from '../../../../../data/classroom-packs.mjs';
export function getStaticPaths(){return CLASSROOM_PACKS.map(pack=>({params:{pack:pack.id},props:{pack}}));}
const {pack}=Astro.props;
---
<BaseLayout title={pack.title['zh-Hant']} description={pack.summary['zh-Hant']} locale="zh-Hant" type="Teaching" topicIds={pack.topicIds} alternatePath={classroomPackHref(pack.id)}><ClassroomPackPage packId={pack.id} locale="zh-Hant"/></BaseLayout>
