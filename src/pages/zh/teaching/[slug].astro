---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const levelLabels: Record<string, string> = {
  Beginner: "入門",
  Competition: "競賽",
  Advanced: "進階",
  Instructor: "教師"
};
const typeLabels: Record<string, string> = {
  "Course pathway": "課程路徑",
  "Python lab": "Python 實驗",
  "Worked example": "完整案例",
  "Instructor resource": "教師資源",
  "Student research": "學生研究",
  "Competition archive": "競賽題解資源庫"
};

export async function getStaticPaths() {
  return (await getCollection("teachingZh", ({ data }) => !data.draft))
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const all = (await getCollection("teachingZh", ({ data }) => !data.draft))
  .filter((item) => item.data.slug !== entry.data.slug);
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  type="教學"
  locale="zh-Hant"
  alternatePath={`/teaching/${entry.data.sourceSlug}/`}
>
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">{levelLabels[entry.data.level]} · {typeLabels[entry.data.resourceType]}</p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.summary}</p>
    </div>
  </header>
  <div class="container content-shell teaching-detail">
    <aside>
      <dl class="metadata">
        <div><dt>程度</dt><dd>{levelLabels[entry.data.level]}</dd></div>
        <div><dt>形式</dt><dd>{typeLabels[entry.data.resourceType]}</dd></div>
        <div><dt>更新</dt><dd>{entry.data.lastUpdated.toLocaleDateString("zh-Hant-TW", { dateStyle: "long" })}</dd></div>
      </dl>
      <p class="small"><strong>共同證據循環</strong><br/>問題 → 假設 → 基準 → 計算 → 驗證 → 溝通</p>
      <div class="tag-list">{entry.data.topics.map((topic) => <span class="tag">{topic}</span>)}</div>
      <div class="actions">
        {entry.data.downloadUrl && <a class="button" href={entry.data.downloadUrl}>下載教學資源</a>}
        <a class="button secondary" href="/zh/teaching/">返回教學概覽</a>
      </div>
    </aside>
    <article class="prose">
      <Content />
      <h2>繼續探索</h2>
      <ul class="related-list">{all.slice(0, 4).map((item) => <li>
        <a href={`/zh/teaching/${item.data.slug}/`}>{item.data.title}</a>
        <span>{levelLabels[item.data.level]} · {typeLabels[item.data.resourceType]}</span>
      </li>)}</ul>
    </article>
  </div>
</BaseLayout>
