---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import G10Inquiry from '../../../../../components/G10Inquiry.astro';
import {inquiries,inquiryUrl} from '../../../../../data/g10-inquiries.mjs';
export function getStaticPaths(){return inquiries.map(activity=>({params:{id:activity.id},props:{activity}}));}
const {activity}=Astro.props;
---
<BaseLayout title={activity.title['zh-Hant']} description={activity.question['zh-Hant']} type="教學" locale="zh-Hant" alternatePath={inquiryUrl(activity.id,'en')} topicIds={['mathematical-thinking','teaching-research-practice']}><G10Inquiry locale="zh-Hant" activityId={activity.id}/></BaseLayout>
