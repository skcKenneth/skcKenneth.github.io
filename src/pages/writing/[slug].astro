---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleReader from '../../components/ArticleReader.astro';
import { getTopicIds } from '../../data/site-reader.mjs';

export async function getStaticPaths() {
  const entries = (await getCollection('writing', ({ data }) => !data.draft || import.meta.env.DEV))
    .filter(entry => entry.data.slug !== 'legacy-archive')
    .sort((a, b) => (a.data.date?.valueOf() || 0) - (b.data.date?.valueOf() || 0));
  const translations = await getCollection('writingZh', ({ data }) => !data.draft || import.meta.env.DEV);
  return entries.map((entry, index) => ({ params: { slug: entry.data.slug }, props: {
    entry, entries, previous: entries[index - 1], next: entries[index + 1],
    alternatePath: translations.find(translated => translated.data.sourceSlug === entry.data.slug)?.data.slug
  } }));
}
const { entry, entries, previous, next, alternatePath } = Astro.props;
const { Content, headings } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.summary} image={entry.data.heroImage} type="Writing" locale="en" alternatePath={alternatePath ? `/zh/writing/${alternatePath}/` : undefined} articleData={entry.data} topicIds={getTopicIds(entry.data)}>
  <ArticleReader entry={entry} entries={entries} headings={headings} previous={previous} next={next}><Content /></ArticleReader>
</BaseLayout>
