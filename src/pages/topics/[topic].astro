---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicPage from '../../components/TopicPage.astro';
import { TOPICS } from '../../data/site-reader.mjs';
export async function getStaticPaths() {
  const [entries, research, projects] = await Promise.all([
    getCollection('writing', ({ data }) => !data.draft && data.slug !== 'legacy-archive'),
    getCollection('research', ({ data }) => !data.draft), getCollection('projects', ({ data }) => !data.draft)
  ]);
  return TOPICS.map(topic => ({ params: { topic: topic.id }, props: { topic, entries, research, projects } }));
}
const { topic, entries, research, projects } = Astro.props;
---
<BaseLayout title={topic.label.en} description={topic.description.en} type="Topics" topicIds={[topic.id]} alternatePath={`/zh/topics/${topic.id}/`}><TopicPage topic={topic} entries={entries} research={research} projects={projects} /></BaseLayout>
