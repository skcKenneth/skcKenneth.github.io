---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: string;
  locale?: "en" | "zh-Hant";
  alternatePath?: string;
}

const {
  title,
  description = "Research, education, and computational experiments in mathematical modeling.",
  image = "/images/og-image.svg",
  noindex = false,
  type,
  locale = "en",
  alternatePath
} = Astro.props;

const isZh = locale === "zh-Hant";
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = alternatePath ? new URL(alternatePath, Astro.site) : undefined;
const nav = isZh
  ? [
      ["研究", "/zh/research/"],
      ["教學", "/zh/teaching/"],
      ["文章", "/zh/writing/"],
      ["專案", "/zh/projects/"],
      ["關於", "/zh/about/"],
      ["搜尋", "/zh/search/"]
    ]
  : [
      ["Research", "/research/"],
      ["Teaching", "/teaching/"],
      ["Writing", "/writing/"],
      ["Projects", "/projects/"],
      ["About", "/about/"],
      ["Search", "/search/"]
    ];
const current = Astro.url.pathname;
const updated = isZh ? "2026 年 7 月 28 日" : "28 July 2026";
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ed" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {type && <meta name="pagefind:filter" content={`type:${type}`} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    {alternate && <link rel="alternate" hreflang={isZh ? "en" : "zh-Hant"} href={alternate} />}
    <meta property="og:title" content={`${title} — Kenneth Cheng`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:locale" content={isZh ? "zh_TW" : "en_GB"} />
    <title>{title} — Kenneth Cheng</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{isZh ? "跳至主要內容" : "Skip to content"}</a>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href={isZh ? "/zh/" : "/"}>Kenneth Cheng<span>{isZh ? "數學建模" : "Mathematical modeling"}</span></a>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-nav">{isZh ? "選單" : "Menu"}</button>
        <nav aria-label={isZh ? "主要導覽" : "Primary"}>
          <ul class="nav-list" id="primary-nav">
            {nav.map(([label, href]) => <li><a href={href} aria-current={current.startsWith(href) ? "page" : undefined}>{label}</a></li>)}
            <li class="language-switch"><a href={alternatePath || (isZh ? "/" : "/zh/")} lang={isZh ? "en" : "zh-Hant"}>{isZh ? "EN" : "中文"}</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" data-pagefind-body><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <strong>Kenneth Cheng</strong>
          <p>{isZh ? "澳門數學教育工作者，研究數學建模、計算實驗、教學設計與學生研究培育。" : "Mathematics educator in Macau working across mathematical modeling, computational experiments, teaching, and student research pathways."}</p>
        </div>
        <div>
          <strong>{isZh ? "其他連結" : "Elsewhere"}</strong>
          <p><a href="https://github.com/skcKenneth">GitHub</a><br/><a href="mailto:sokkincheng@gmail.com">{isZh ? "電郵" : "Email"}</a><br/><a href={isZh ? "/zh/about/#cv" : "/about/#cv"}>CV</a></p>
        </div>
        <div>
          <strong>{isZh ? "網站來源" : "Source"}</strong>
          <p><a href="https://github.com/skcKenneth/skcKenneth.github.io">{isZh ? "網站原始碼庫" : "Site repository"}</a></p>
          <p class="small">{isZh ? "技術研究紀錄存放於私人工作區。" : "Technical research records are maintained privately."}<br/>{isZh ? "更新：" : "Updated "}{updated}</p>
        </div>
      </div>
    </footer>
    <script is:inline>
      const button = document.querySelector(".menu-button");
      const nav = document.querySelector("#primary-nav");
      button?.addEventListener("click", () => {
        const open = button.getAttribute("aria-expanded") !== "true";
        button.setAttribute("aria-expanded", String(open));
        nav?.setAttribute("data-open", String(open));
      });
    </script>
  </body>
</html>
