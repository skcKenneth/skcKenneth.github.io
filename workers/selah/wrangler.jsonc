{
  "name": "selah-math-whiteboard",
  "main": "index.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "ai": { "binding": "AI" },
  "vars": {
    "SELAH_ENABLED": "false",
    "SELAH_ORIGIN": "https://skckenneth.github.io",
    "SELAH_INVITE_EXPIRES_AT": ""
  },
  "durable_objects": {
    "bindings": [{ "name": "SELAH_QUOTA", "class_name": "SelahQuota" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SelahQuota"] }]
}
